        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Step Clock Forwarder

global.timeSeconds += global.timescale / global.timescaleDivide;

while (global.timeSeconds &gt;= 60)
{
    global.timeSeconds -= 60;
    global.timeMinutes += 1;
}
while (global.timeMinutes &gt;= 60)
{
    global.timeMinutes -= 60;
    global.timeHour += 1;
}
if (global.timeHour &gt;= 24)
{
    global.timeHour = 0;
}
</string>
          </argument>
        </arguments>
      </action>
