        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Check Day of Week

if global.timeHour == 23
{
    doOnceLoop = true;
}

//If time reaches midnight
if global.timeHour == 0 &amp;&amp; global.timeMinutes == 0 &amp;&amp; global.timeSeconds &lt;= 1
{
    if doOnceLoop == true
    {
        global.daysOfWeekIndex += 1;
        doOnceLoop = false;
    }    
          
} 

if global.daysOfWeekIndex &gt; 7
{
    global.daysOfWeekIndex = 1;   
}

//Sequence
if global.daysOfWeekIndex == 1
{
    global.daysofWeekString = "Monday";
    global.newWeekString = "Monday";
     
} 

else if global.daysOfWeekIndex == 2
{
    global.daysOfWeekString = "Tuesday";
    global.newWeekString = "Tuesday";
} 

else if global.daysOfWeekIndex == 3
{
    global.daysOfWeekString = "Wednesday";
    global.newWeekString = "Wednesday";
} 

else if global.daysOfWeekIndex == 4
{
    global.daysOfWeekString = "Thursday";
    global.newWeekString = "Thursday";
} 

else if global.daysOfWeekIndex == 5
{
    global.daysOfWeekString = "Friday";
    global.newWeekString = "Friday";
} 

else if global.daysOfWeekIndex == 6
{
    global.daysOfWeekString = "Saturday";
    global.newWeekString = "Saturday";
} 

else if global.daysOfWeekIndex == 7
{
    global.daysOfWeekString = "Sunday";
    global.newWeekString = "Sunday";
} 
</string>
          </argument>
        </arguments>
      </action>
