          <argument>
            <kind>1</kind>
            <string>///Day and night cycle timings

// Wrap at midnight
if global.timeHour &gt;= 24 //if time is 24:00
{
    global.timeHour = 0;
    
    global.startFog = 1200;
    global.endFog = 1200;
    
    global.lightingAmbienceR = 20;
    global.lightingAmbienceG = 20;
    global.lightingAmbienceB = 20;
    
    //global.startFog = -2400;
    //global.endFog = 1200; 
}

if global.timeHour == 1
{
    global.startFog = 1200
    global.endFog = 1200
    global.lightingAmbienceR = 30;
    global.lightingAmbienceG = 30;
    global.lightingAmbienceB = 30;
    //global.startFog = -2200
    //global.endFog = 1200
}

if global.timeHour == 2
{
