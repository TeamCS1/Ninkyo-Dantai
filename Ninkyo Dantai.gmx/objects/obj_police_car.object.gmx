    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Car Controller
with obj_player_buruwasu
{
    sprite_index = spr_empty    //Hide the player
    x = obj_police_car.x
    y = obj_police_car.y
}

fakeSpeed = speed * 15;

var a = keyboard_check(vk_left);
var d = keyboard_check(vk_right);
var w = keyboard_check(vk_up);
var s = keyboard_check(vk_down);

if (w) 
{
    speed += acceleration;
    needleRot -= 0.25 //rotates arrow clockwise
}

if (d)
{
    direction -= speed*turnradius;
}


if (s) 
{
    speed -= brake;
}

if (a)
{
    direction += speed*turnradius;
}

//braking
if !w and !s
{
    if friction &lt; 1 
    {  
        friction += 0.001 / brakeStrength;
        
        if speed &gt; 0
        {
            needleRot += 1
        }
    }
}
else friction = 0;

//set max speed forward and reverse
if speed &gt; forwardspd 
{
    speed = forwardspd
}

if speed &lt; reversespd 
{
    speed = reversespd
}

//limits the turning the faster you go

if speed &gt; 3
{
    turnradius = 0.5
    //lower number low radius
}

if speed &lt; 3
{
    turnradius = 1
    //lower number low radius
}

//gear numbers
if fakeSpeed &lt;= 0
{
    gearNumber = "R"
    needleRot = 25;
}

if needleRot &gt; 25
{
    needleRot = 25;    
}

if fakeSpeed &gt; 0 &amp;&amp; fakeSpeed &lt; 5
{
    gearNumber = "1"
}

if fakeSpeed &gt; 6 &amp;&amp; fakeSpeed &lt; 23
{
    gearNumber = "2"
}

if fakeSpeed &gt; 24 &amp;&amp; fakeSpeed &lt; 30
{
    gearNumber = "3"
}

if fakeSpeed &gt; 31 &amp;&amp; fakeSpeed &lt; 40
{
    gearNumber = "4"
}

if fakeSpeed &gt; 41 &amp;&amp; fakeSpeed &lt; 53
{
    gearNumber = "5"
}

if fakeSpeed &gt; 54 
{
    gearNumber = "6"
}

//Re-adjusts needle
if fakeSpeed == 20
{
    needleRot = -1.75;
}

else if fakeSpeed == 30
{
    needleRot = -12.2;
}

else if fakeSpeed == 40
{
    needleRot = -28.7;
}

else if fakeSpeed == 50
{
    needleRot = -40.2;    
}

else if fakeSpeed == 60
{
    needleRot = -55;    
}

else if fakeSpeed == 70
{
    needleRot = -68.2;        
}

else if fakeSpeed == 80
{
    needleRot = -82.5;       
}

else if fakeSpeed &gt;= 90 
{
    needleRot = -98;
}
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Car Camera dynamics

if global.carZooming == true
{
    // Define the minimum and maximum zoom levels
    var minZoom = 700;
    var maxZoom = 1020;
    
    // Define the speed range for the logarithmic function
    var minSpeed = 0;
    var maxSpeed = 80;
    
    // Calculate the zoom level based on the speed using a logarithmic function
    var speedRange = logn(10, maxSpeed - minSpeed + 1);
    var zoomRange = maxZoom - minZoom;
    var speedRatio = logn(10, fakeSpeed - minSpeed + 1) / speedRange;
    var zoomLevel = round(minZoom + zoomRange * speedRatio);
    
    // Set the zoom level
    if fakeSpeed &gt;=0
    {
        obj_control.ztobe = zoomLevel - 200;
        obj_control.z = zoomLevel;
    }
}
</string>
          </argument>
        </arguments>
      </action>
