<object>
  <spriteName>&lt;undefined&gt;</spriteName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>1000000</depth>
  <persistent>0</persistent>
  <parentName>&lt;undefined&gt;</parentName>
  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Init 3D
//remove menu sprite
sprite_flush(spr_main_menus);

//3D Global vars (These control the brighness of the scene)
//Current fog state. These are outputs now - scr_FogWeatherUpdate writes
//them every step from global.fogIntensity, so setting them by hand
//anywhere else will just be overwritten on the next frame.
global.startFog = 3000;
global.endFog = 6000;
global.fogR = 66;
global.fogG = 70;
global.fogB = 80;

//---- Fog weather system (scr_FogWeatherUpdate) ----
global.fogIntensity = 0;    //0 clear, 1 full thickness. Everything else derives from this.
global.fogActive = false;   //is a bank currently rolling in / holding?
global.fogClearHour = -1;   //hour it will start lifting, picked when it starts
global.fogLastHour = -1;    //so the once-per-hour dice are rolled once, not every step
global.fogForced = false;   //debug override from the /fog console command - see scr_FogWeatherUpdate

//Chance of a bank starting, in percent, checked on the hour
global.fogChanceMidnight = 10;  //00:00
global.fogChanceLate = 5;       //02:00

//How fast it arrives and leaves, per step. The clock advances 1.5 game
//seconds a step at the default timescale, so a game hour is about 2400
//steps - 0.0008 rolls in over roughly half a game hour, 0.0005 lifts over
//about three quarters of one. Fog lifts more slowly than it arrives.
global.fogRampSpeed = 0.0008;
global.fogClearSpeed = 0.0005;

//Distance the fog occupies. Clear values sit beyond the draw distance so
//nothing is tinted at all; thick values close inside it so the street
//genuinely disappears.
global.fogClearStart = 3000;
global.fogClearEnd = 6000;
global.fogThickStart = 150;
global.fogThickEnd = 1000;

//Colour at each end. Thin fog reads as a cool grey rather than white,
//which is what makes it look like weather instead of the screen fading.
global.fogThinR = 66;
global.fogThinG = 70;
global.fogThinB = 80;
global.fogThickR = 255;
global.fogThickG = 255;
global.fogThickB = 255;

//3D lighting variables
global.lightingAmbienceR = 0;
global.lightingAmbienceG = 0;
global.lightingAmbienceB = 0;

//Init 3D
d3d_start();
d3d_set_perspective(1);
d3d_set_culling(1);
d3d_set_hidden(1);
d3d_set_shading(1);

//CONFIGS
//Sets coloured fog
d3d_set_fog(true, make_colour_rgb(global.fogR,global.fogG,global.fogB), global.startFog, global.endFog);
draw_set_alpha_test(true);
draw_set_alpha_test_ref_value(128);

//Quality-texture cache (scr_UpdateQualityTextureCache). Forced dirty on
//every room entry: cleanmem() runs on room transitions and can unload
//texture pages, which kills any texture pointer cached in the previous
//room. -1 never equals a real quality setting, so the first Begin Step of
//the room rebuilds everything before anything draws.
global.texCacheBuildingQ = -1;
global.texCachePropsQ = -1;
global.texCacheEnvironmentQ = -1;
global.texCacheTreeQ = -1;

//LIGHTING ENGINE SETUP
//Lighting starts OFF, and that is deliberate. Every object that wants it
//turns it on for its own draw and off again afterwards, so "off" is the
//resting state between objects.
//
//This used to be d3d_set_lighting(true), which left it on from room start
//with nothing responsible for putting it back. Anywhere the player stood
//with no lighting-managing object in draw range, it simply stayed on, and
//everything drawn after - models, sprites, text and the whole Draw GUI
//including the minimap - was rendered against the ambient light. At
//midday that ambient is pure white (255,255,255), so the screen washed
//out completely until you walked near a building, whose own draw turned
//lighting off again.
d3d_set_lighting(false);

ztobe = 500; // Smooth Zoom
bearing = 90;
bearingtobe = bearing;
strafe = 0;
bearingmode = 0;
doVendingMachineInteraction = false;
tempX = -1;
tempY = -1;
z = 700;
zt = 0;
pitch = 6000;
vector_x = 900;
vector_y = 500;
vector_z = -6000;

prepare_look(x,y,z,x+vector_x,y+vector_y,z+vector_z,0,0,1,45,1.333333);
global.mousex = x;
global.mousey = y;

//pre-fetch sprites to avoid stalls.
prefetch_vehicles[0] = spr_car_icon;
prefetch_vehicles[1] = spr_scooter_icon;

sprite_prefetch_multi(prefetch_vehicles);
sprite_prefetch(uv_drop_bag_of_money_1024);
sprite_prefetch(uv_drop_bag_of_money_512);
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="1">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>//Refresh the quality-texture cache. Cheap (four compares) unless a
//quality setting changed or we just entered the room.
scr_UpdateQualityTextureCache();

///Scenery culling - deactivates distant static geometry so its events
//stop running. Deliberately never touches NPCs; see the script header.
scr_CullDistantScenery();

///Mouse Look

//Yourself has provided the base code for Total Anarchy's camera and mouse aiming. Many thanks :)
prepare_look(x,y,z,x+vector_x,y+vector_y,z+vector_z,0,0,1,45,1.3333)

var width; var height; var mX; var mY; var mZ; var placex; var placey;
//room size, room view, and screen setting interact in ways that can
//throw the selection script off. If you have problems you will have to
//hack around until you find a solution

xscreen=2*mouse_x/view_wview[0]-1//window_get_width()-1
yscreen=1-2*mouse_y/view_hview[0]//window_get_height()
mX = dX+uX*yscreen+vX*xscreen;
mY = dY+uY*yscreen+vY*xscreen;
mZ = dZ+uZ*yscreen+vZ*xscreen;

if mZ=0 then mZ=.0001 //error handling

//NUST define at least one coordinate for 3d mouse select.
//z coordinate, the target elevation is zt.

placex=x-(z-zt)*mX/mZ
placey=y-(z-zt)*mY/mZ



//original form of the mouse select script
width=2*mouse_x/window_get_width()-1
height=1-2*mouse_y/window_get_height()
mX = dX+uX*height+vX*width;
mY = dY+uY*height+vY*width;
mZ = dZ+uZ*height+vZ*width;
mm = sqrt(mX*mX+mY*mY+mZ*mZ);
global.mouse_dx = mX/mm;
global.mouse_dy = mY/mm;
global.mouse_dz = mZ/mm;

global.mousex = placex
global.mousey = placey

if bearing &lt;0 bearing = 359
if bearing &gt;360 bearing = 0
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Player
strafe -= friction * sign(strafe);
if (abs(strafe) &lt; friction) strafe = 0;
x += lengthdir_x(strafe, direction - 90);
y += lengthdir_y(strafe, direction - 90);

if pitch &lt; 300
{
    pitch = 300;
}

//Player stamina
global.currentStaminaCount += 1 / 1000; 

</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Freeze player script

if global.freezePlayer == true
{
    with obj_player_buruwasu
    {
        x = xprevious;
        y = yprevious;
    }
}

if global.enablePlayerCollisionsInWorldBuruwasu == false
{
    with obj_player_buruwasu
    {
        mask_index = spr_empty;
    }
}

else if global.enablePlayerCollisionsInWorldBuruwasu == true
{
    mask_index = mask_player;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="6" enumb="61">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if global.isMenuMouseScrolling == 0
{
    ztobe -= 15;
    z += 5;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="6" enumb="60">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if global.isMenuMouseScrolling == 0
{
    //Z zooms in
    ztobe += 15;
    z -= 5;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Camera Code

//Camera follows player
x = obj_player_buruwasu.x  + lengthdir_x(-ztobe/4,bearing)
y = obj_player_buruwasu.y  + lengthdir_y(-ztobe/4,bearing)

//camera pitch
draw_set_color(c_white)
pitch = max(min(pitch,80),-80); //this limits camera pitch -is up, + is down

ss = sin(degtorad(bearing));cc = cos(degtorad(bearing));
vector_x=cc*cos(degtorad(-pitch));
vector_y=ss*-cos(degtorad(-pitch));

vector_z=(sin(degtorad(-pitch))) + (ztobe/2500)

//I advise normalizing the projection vector
//You MUST set the aspect ratio to 1.3333 (the same as the monitor), you cannot use d3d_set_projection
//there is (or was) something buggy with d3d_set_projection- defaults to 41 when it says 45, something like that

//The camera! zfar = 10,000
if global.cameraInteriors == false
{
    d3d_set_projection_ext(x,y,z,x+vector_x,y+vector_y,z+vector_z,0,0,1,45,1.3333,0.1,10000) //2
}

else if global.cameraInteriors == true  //in a interior
{
    d3d_set_projection_ext(x,y,z,x+vector_x,y+vector_y,z+vector_z,0,0,1,45,1.3333,0.1,10000) //2
}

//SETTINGS
// 4 / 3 = 1.3333
//16/9 = 1.7777

//LIGHTING
d3d_light_define_ambient(make_colour_rgb(global.lightingAmbienceR,global.lightingAmbienceG,global.lightingAmbienceB)); //used for day and night time

</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>scr_lightSource_Controller();
</string>
          </argument>
        </arguments>
      </action>
    </event>
