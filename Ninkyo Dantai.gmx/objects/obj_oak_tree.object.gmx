  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>zIsTwoPoints = false; //used for map editor
z = 0;
zDirection = 0;
tree = scr_load_model(working_directory + "Assets\Buruwasu\oak_tree.d3d");
//setup collisions
image_xscale = 1.0;
image_yscale = 1.0;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if distance_to_object(obj_player_buruwasu) &lt; 64
{
    //make sure drawing colors are reset to white
    draw_set_color(c_white);
    //turn on texture repeating so our UV's work right
    texture_set_repeat(1);;
    //d3d_set_culling(0);
    d3d_set_lighting(0) //make sure house lighting is false. Somehow lighting works when off lmao 
    
    d3d_transform_set_scaling(1,1,1);
    d3d_transform_add_rotation_z(zDirection);
    d3d_transform_add_translation(x, y, z);
    d3d_model_draw(tree, 0, 0, 0,sprite_get_texture(spr_transparent_texture_buruwasu,0));
    //d3d_set_culling(0);
    draw_set_alpha(1)
    d3d_transform_set_identity();
}

else if point_distance(x, y, global.playerX, global.playerY) &lt; global.drawOCRange
{
    //make sure drawing colors are reset to white
    draw_set_color(c_white);
    //turn on texture repeating so our UV's work right
    texture_set_repeat(1);;
    //d3d_set_culling(0);
    d3d_set_lighting(0) //make sure house lighting is false. Somehow lighting works when off lmao 
    d3d_transform_set_scaling(1,1,1);
    d3d_transform_add_rotation_z(zDirection);
    d3d_transform_add_translation(x, y, z);
    
    switch(global.treeQuality)
    {
        case 1 :
            d3d_model_draw(tree, 0, 0, 0, sprite_get_texture(uv_oak_tree_64_64,0));
            break;
        case 2 :
            d3d_model_draw(tree, 0, 0, 0, sprite_get_texture(uv_oak_tree_128_128,0));
            break;
        case 3 :
            d3d_model_draw(tree, 0, 0, 0, sprite_get_texture(uv_oak_tree_256_256,0));
            break;
        case 4 :
            d3d_model_draw(tree, 0, 0, 0, sprite_get_texture(uv_oak_tree_512_512,0));
            break;
        case 5 :
            d3d_model_draw(tree, 0, 0, 0, sprite_get_texture(uv_oak_tree_1024_1024,0));
            break;
    }
    
    //d3d_set_culling(0);
    draw_set_alpha(1)
    d3d_transform_set_identity();
}

else
{
    sprite_flush(uv_oak_tree_64_64);
    sprite_flush(uv_oak_tree_128_128);
    sprite_flush(uv_oak_tree_256_256);
    sprite_flush(uv_oak_tree_512_512);
    sprite_flush(uv_oak_tree_1024_1024);
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
  <PhysicsObject>0</PhysicsObject>
  <PhysicsObjectSensor>0</PhysicsObjectSensor>
  <PhysicsObjectShape>0</PhysicsObjectShape>
