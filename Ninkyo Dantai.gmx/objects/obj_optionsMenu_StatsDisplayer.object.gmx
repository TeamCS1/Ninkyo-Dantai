        <arguments>
          <argument>
            <kind>1</kind>
            <string>//Calculate Prayer Shrines
global.prayerShrinesCollected = 0;

// Count collected prayer shrines
for (var i = 0; i &lt; 5; i++) {
    if (global.prayerShrines[i, 2]) {
        global.prayerShrinesCollected += 1;
    }
}

//calculate game completion
global.overallGameCompletion = global.prayerShrinesCollected * 20;

</string>
          </argument>
        </arguments>
      </action>
    </event>
