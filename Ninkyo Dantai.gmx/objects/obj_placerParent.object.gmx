  <spriteName>&lt;undefined&gt;</spriteName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>0</depth>
  <persistent>0</persistent>
  <parentName>&lt;undefined&gt;</parentName>
  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>global.selectedTarget = noone;
global.selectionIndex = 0;
global.GRID_SIZE = 8;
global.isMenuMouseScrolling = 1;

//Add moveable objects here
global.movableTypes = ds_list_create();
ds_list_add(global.movableTypes, obj_fridge);
ds_list_add(global.movableTypes, obj_cabinet);
ds_list_add(global.movableTypes, obj_bed);

instance_create(0,0,obj_cursor_grab_64);
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="64">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if global.homeBuildingMode
{

    //-----------------------------------------------------------
    // 1) Build sortable list of all movable instances
    //-----------------------------------------------------------
    var px = obj_player_buruwasu.x;
    var py = obj_player_buruwasu.y;

    var tempList = ds_list_create();

    // ----------------------------------------------------------
    // Add "NONE" at index 0
    // ----------------------------------------------------------
    var noneEntry = ds_list_create();
    ds_list_add(noneEntry, noone); // ID
    ds_list_add(noneEntry, 0);     // dist 
    ds_list_add(tempList, noneEntry);


    // ----------------------------------------------------------
    // Add all movable objects starting from index 1
    // ----------------------------------------------------------
    for (var i = 0; i &lt; ds_list_size(global.movableTypes); i++)
    {
        var type = global.movableTypes[| i];

        with (type)
        {
            var dist = point_distance(px, py, x, y);

            var entry = ds_list_create();
            ds_list_add(entry, id);   // instance ID
            ds_list_add(entry, dist); // distance

            ds_list_add(tempList, entry);
        }
    }

    // ----------------------------------------------------------
    //  Re-sort list (but keep NONE at index 0)
    // ----------------------------------------------------------
    if (ds_list_size(tempList) &gt; 1)
    {
        // Sort everything
        ds_list_sort(tempList, true);

        // Move our NONE entry back to index 0 if needed
        // (sorting might reorder it)
        if (tempList[| 0] != noneEntry)
        {
            // Delete the duplicate NONE at bottom
            ds_list_delete(tempList, ds_list_find_index(tempList, noneEntry));

            // Reinsert at the top
            ds_list_insert(tempList, 0, noneEntry);
        }
    }


    //-----------------------------------------------------------
    // 2) Scroll pointer with mouse wheel
    //-----------------------------------------------------------
    if global.isMenuMouseScrolling == 1
    {
        if (mouse_wheel_up())
        {
            global.selectionIndex = max(global.selectionIndex - 1, 0);
        }
    
        if (mouse_wheel_down())
        {
            global.selectionIndex = min(global.selectionIndex + 1, ds_list_size(tempList) - 1);
        }
    }

    //-----------------------------------------------------------
    // 3) Assign selectedTarget
    //-----------------------------------------------------------
    if (ds_list_size(tempList) &gt; 0)
    {
        var entry = tempList[| global.selectionIndex];
        global.selectedTarget = entry[| 0]; // can be noone
    }
    else
    {
        global.selectedTarget = noone;
        global.selectionIndex = 0;
    }

    //-----------------------------------------------------------
    // 3.5) Move grab cursor to selected target
    //-----------------------------------------------------------
    
    if (global.selectedTarget != noone &amp;&amp; instance_exists(global.selectedTarget))
    {
        obj_cursor_grab_64.visible = true;
    }
    else
    {
        obj_cursor_grab_64.visible = false;
    }
    
    // Freeze player if something is selected
    global.freezePlayer = global.selectedTarget != noone

    //Movement
    if (global.selectedTarget != noone &amp;&amp; instance_exists(global.selectedTarget)) {
    
        move_dx = (keyboard_check_pressed(vk_right) - keyboard_check_pressed(vk_left)) * global.GRID_SIZE;
        move_dy = (keyboard_check_pressed(vk_down) - keyboard_check_pressed(vk_up)) * global.GRID_SIZE;
        
        if (move_dx != 0 || move_dy != 0) {
            
            with (global.selectedTarget) {
                x += other.move_dx;
                y += other.move_dy;
            }   
        }
    }



    //-----------------------------------------------------------
    // 4) Draw the list on screen
    //-----------------------------------------------------------
    draw_set_font(ft_vending_gui);
    draw_set_color(c_white);
    draw_text(20, 20, "SELECTABLE OBJECTS List → ");
    
    //draw background rectangle
    var line_h = 20;
    var pad = 7;
    
    var rectangle_y = ds_list_size(tempList) * line_h + pad * 2;
    
    // draw background rectangle
    draw_set_color(c_black);
    draw_set_alpha(0.6);
    draw_rectangle(15, 45, 535, 45 + rectangle_y, false);
    
    draw_set_alpha(1);

    var yy = 50;

    for (var i = 0; i &lt; ds_list_size(tempList); i++)
    {
        var entry = tempList[| i];
        var inst_id = entry[| 0];
        var dist    = entry[| 1];

        // NAME
        var obj_name;
        if (inst_id == noone)
            obj_name = "NONE";
        else
            obj_name = object_get_name(inst_id.object_index);

        // Highlight selected
        if (i == global.selectionIndex)
            draw_set_color(c_yellow);
        else
            draw_set_color(c_gray);

        draw_text(20, yy,
            string(i) + ": " + obj_name +
            " (ID: " + string(inst_id) +
            ") (Dist: " + string(round(dist)) + ")"
        );

        yy += 20;
    }


    //-----------------------------------------------------------
    // 5) Clean up
    //-----------------------------------------------------------
    for (var i = 0; i &lt; ds_list_size(tempList); i++)
    {
        ds_list_destroy(tempList[| i]); // destroy entry lists
    }

    ds_list_destroy(tempList);
}

</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
  <PhysicsObject>0</PhysicsObject>
  <PhysicsObjectSensor>0</PhysicsObjectSensor>
  <PhysicsObjectShape>0</PhysicsObjectShape>
  <PhysicsObjectDensity>0.5</PhysicsObjectDensity>
  <PhysicsObjectRestitution>0.100000001490116</PhysicsObjectRestitution>
  <PhysicsObjectGroup>0</PhysicsObjectGroup>
  <PhysicsObjectLinearDamping>0.100000001490116</PhysicsObjectLinearDamping>
  <PhysicsObjectAngularDamping>0.100000001490116</PhysicsObjectAngularDamping>
  <PhysicsObjectFriction>0.200000002980232</PhysicsObjectFriction>
  <PhysicsObjectAwake>-1</PhysicsObjectAwake>
  <PhysicsObjectKinematic>0</PhysicsObjectKinematic>
  <PhysicsShapePoints/>
</object>
