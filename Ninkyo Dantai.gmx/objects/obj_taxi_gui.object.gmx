      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Draw Menu Code
if onTaxiCollision == 1
{
    draw_sprite_ext(spr_filter,0,750,200,15,15,0,c_black,1)
    draw_set_font(ft_speedometer_buruwasu)
    draw_set_color(c_white);
    draw_text(770,220,"Taxi Menu")
    
    draw_set_color(c_red);
    draw_text(790,260,"[Go to: Konan]");
    draw_set_color(c_purple);
    draw_text(790,300,"[Go to: Nagasegai]");
    draw_set_color(c_green);
    draw_text(790,340,"[Go to: Yokyohama]");
    draw_set_color(c_teal);
    draw_text(790,380,"[Go to: Ichihara]");
    draw_set_color(c_orange);
    draw_text(790,420,"[Go to: Buruwasu]");
    
    draw_set_color(c_white);
    draw_text(770,pointerYPos,"&gt;")
     
}

if drawLoadingScreen == true
{
    draw_set_color(c_black)
    draw_rectangle(0,0,5000,5000,false)
    draw_set_font(ft_speedometer_buruwasu)
    draw_set_color(c_white)
    draw_text(200,200,"Loading... " + string(loadingPercentage) + " " + string(loadingString));

    //The city description sits in a curved panel drawn in code by
    //scr_DrawCurvedPanel. This used to be draw_sprite(spr_curved_rectangle),
    //a full-screen 1920x1080 image, and it crashed fast travel to every
    //city because that sprite has never existed as a resource. GML reads an
    //unknown name as an undefined VARIABLE, which is why the error said
    //"not set before reading it" instead of naming a missing sprite.
    //
    //Set the font BEFORE measuring: string_height_ext measures against
    //whatever font is current, so measuring first sizes the panel to the
    //wrong one. Same trap as scr_DrawNotificationBox.
    draw_set_font(ft_map_editor_buruwasu);

    var _textX = 70;
    var _textY = 900;
    var _textWrap = 1750;
    var _textLine = 30;
    var _textPad = 26;
    var _textHeight = string_height_ext(string(loadingStringLocale), _textLine, _textWrap);

    //Width comes from the text actually drawn, not the wrap limit, so the
    //panel hugs a short description instead of always spanning 1750px.
    //Two of the city descriptions are still the placeholder "GG", which a
    //fixed-width panel would frame in a box the width of the screen.
    var _textWidth = string_width_ext(string(loadingStringLocale), _textLine, _textWrap);

    scr_DrawCurvedPanel(_textX - _textPad,
                        _textY - _textPad,
                        _textX + _textWidth + _textPad,
                        _textY + _textHeight + _textPad,
                        28,
                        14);

    draw_set_colour(c_white);
    draw_text_ext(_textX, _textY, string(loadingStringLocale), _textLine, _textWrap);
}
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Enter Event

// Ensure menuChoice stays in range
if menuChoice &gt; 4 { menuChoice = 0; }
if menuChoice &lt; 0 { menuChoice = 4; }

if keyboard_check_released(vk_enter)
{
    loadingPercentage = "0%";
    
    if menuChoice == 0
    {
        drawLoadingScreen = true;
        draw_texture_flush();
        cleanmem();
    }
    else if menuChoice == 1
    {
        drawLoadingScreen = true;
        draw_texture_flush();
        cleanmem();
    }
    else if menuChoice == 2
    {
        drawLoadingScreen = true;
        draw_texture_flush();
        cleanmem();
    }
    else if menuChoice == 3
    {
        drawLoadingScreen = true;
        draw_texture_flush();
        cleanmem();
    }
    else if menuChoice == 4
    {  
        
        drawLoadingScreen = true;
        draw_texture_flush();
        cleanmem();
        
    }
}

if drawLoadingScreen == true
{
    if wait_time == 0 // Set once at the start
    {
        loadingPercentage = "64%";
        loadingString = "Generating Chunks... Please Wait";
        
        loadingStringLocale = "Unknown City";
        switch(menuChoice)
        {
            case 0: loadingStringLocale = CITY_KONAN_DESC; break;
            case 1: loadingStringLocale = CITY_NAGASEGAI_DESC; break;
            case 2: loadingStringLocale = CITY_YOKYOHAMA_DESC; break;
            case 3: loadingStringLocale = CITY_ICHIHARA_DESC; break;
            case 4: loadingStringLocale = CITY_BURUWASU_DESC; break;
        }
    }
       
    if wait_time &lt; 1000
    {
        wait_time += 1; // Increment timer
    }
    
    if wait_time &gt;= 500 // Wait time reached
    {
        loadingPercentage = "100%"; 
        loadingString = "Finalising... Please Wait";                   
    }

    if wait_time &gt;= 1000 // Wait time reached
    {  
        doTransition = true;                    
    }
    
    if doTransition == true
    {
        if menuChoice == 0
        {
            scr_transitionator(rm_city_buruwasu);
        }
        else if menuChoice == 1
        {
            scr_transitionator(rm_city_nagoya);
        }
        else if menuChoice == 2
        {
            scr_transitionator(rm_city_yokyohama);
        }
        else if menuChoice == 3
        {
            scr_transitionator(rm_city_ichihara);
        }
        else if menuChoice == 4
        {
            scr_transitionator(rm_city_buruwasu);
        }

        // Cleanup
        instance_destroy();
    }
}

</string>
          </argument>
        </arguments>
      </action>
