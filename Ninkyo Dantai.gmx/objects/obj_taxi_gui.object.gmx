        <arguments>
          <argument>
            <kind>1</kind>
            <string>onTaxiCollision = 1;
pointerXPos = 0;
pointerYPos = 260;
menuChoice = 0;
drawLoadingScreen = false;
doTransition = false;
loadingPercentage = "0%";
loadingString = "";
global.freezePlayer = true;
wait_time = 0; 

scr_ClockControl(0,1); //stop clock

</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>
    if menuChoice == 0
    {
        pointerYPos = 260;
    }

    else if menuChoice == 1
    {
        pointerYPos = 300;
    }


    else if menuChoice == 2
    {
        pointerYPos = 340;
    }

    else if menuChoice == 3
    {
        pointerYPos = 380;
    }

    else if menuChoice == 4
    {
        pointerYPos = 420;
    }

    if menuChoice &gt; 4
    {
        menuChoice = 0;
    }

    if menuChoice &lt; 0
    {
        menuChoice = 4;
    }
</string>
          </argument>
        </arguments>
      </action>
    </event>
