        <arguments>
          <argument>
            <kind>1</kind>
            <string>if point_distance(x, y, global.playerX, global.playerY) &lt; global.drawOCRange
{
    //make sure drawing colors are reset to white
    draw_set_color(c_white);
    //turn on texture repeating so our UV's work right
    texture_set_repeat(true);
    d3d_set_lighting(false); //make sure house lighting is false. Somehow lighting works when off lmao
    draw_set_alpha(1);
    d3d_transform_add_scaling(1, 1, 1);
    d3d_transform_add_rotation_z(0);
    d3d_transform_add_translation(x, y, z);
    //LODs
    //Texture picked once by scr_UpdateQualityTextureCache when the quality
    //setting changes - not a sprite_get_texture lookup here every frame.
    d3d_model_draw(prayer1, 0, 0, 0, global.texPrayerShrineStand);
    draw_set_alpha(1)
    d3d_transform_set_identity();
}

//The out-of-range branch used to sprite_flush these textures.
//That ran EVERY frame the instance was out of draw range, not once -
//and sprite_flush unloads a whole texture page, which every sprite in
//this project shares. It was evicting pages that other objects were
//still drawing from, forcing a reload on the next frame.
</string>
          </argument>
        </arguments>
      </action>
    </event>
