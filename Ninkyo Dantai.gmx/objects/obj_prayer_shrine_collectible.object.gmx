        <arguments>
          <argument>
            <kind>1</kind>
            <string>// Draw GUI event

if (obj_prayer_shrine_collectible.doPrayerShrineInteraction)
{
    // Draw the "Press I to collect" prompt
    draw_set_font(ft_buruwasu_gui);
    draw_set_halign(fa_left);
    draw_text_shadow_tooltips(
        string("I - Collect Prayer Shrine"),
        ft_buruwasu_gui, 3, c_black, c_blue, c_white, 1.0, 1.0
    );

    // Check for key press here as well
    if (keyboard_check_pressed(ord("I")))
    {
        var idx = obj_prayer_shrine_collectible.shrineIndex;

        if (!global.prayerShrines[idx, 2])
        {
            global.prayerShrines[idx, 2] = true;
            show_debug_message("Player collected shrine index: " + string(idx));

            // Add any additional effects here (sound, animation, etc.)
            scr_CreateNotifications("Collected Prayer Shrine! No." + string(idx + 1), 350);

        }

        obj_prayer_shrine_collectible.doPrayerShrineInteraction = false; // Hide prompt
    }
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
