          <argument>
            <kind>1</kind>
            <string>zIsTwoPoints = false; //used for map editor
z = 250;
zDirection = 0;

lamp = scr_load_model(working_directory + "Assets\Buruwasu\wall_mounted_oil_lamp.d3d");
//setup collisions
image_xscale = 1.0;
image_yscale = 1.0;

//light source
//lampLight = instance_create(x + 200,y - 280,obj_light_source);
lampLight = instance_create(x + 120, y - 23, obj_light_source);
lampLight.light_z = 64;
lampLight.light_col = choose(c_yellow);
lampLight.light_range = 150;

</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Draw model
if point_distance(x, y, global.playerX, global.playerY) &lt; global.drawOCRange
{
    //make sure drawing colors are reset to white
    draw_set_color(c_white);
    
    //turn on texture repeating so our UV's work right
    texture_set_repeat(1);
    //d3d_set_culling(0);
    d3d_set_lighting(1); //enable lighting
    d3d_transform_set_scaling(1,1,1);
    d3d_transform_add_rotation_z(zDirection);
    d3d_transform_add_translation(x, y, z);
    
    //texture control
    switch(global.propsQuality)
    {
        case 1 :
            d3d_model_draw(lamp, 0, 0, 0, sprite_get_texture(uv_wall_mounted_oil_lamp_64_64,0));
            break;
        case 2 :
            d3d_model_draw(lamp, 0, 0, 0, sprite_get_texture(uv_wall_mounted_oil_lamp_128_128,0));
            break;
        case 3 :
            d3d_model_draw(lamp, 0, 0, 0, sprite_get_texture(uv_wall_mounted_oil_lamp_256_256,0));
            break;
        case 4 :
            d3d_model_draw(lamp, 0, 0, 0, sprite_get_texture(uv_wall_mounted_oil_lamp_512_512,0));
            break;
        case 5 :
            d3d_model_draw(lamp, 0, 0, 0, sprite_get_texture(uv_wall_mounted_oil_lamp_1024_1024,0));
            break;
    }
    
    //reset settings
    //d3d_set_culling(0);
    draw_set_alpha(1)
    d3d_set_lighting(0);
    d3d_transform_set_identity();
    
    
}   
    

//garbage collection

//The out-of-range branch used to sprite_flush these textures.
//That ran EVERY frame the instance was out of draw range, not once -
//and sprite_flush unloads a whole texture page, which every sprite in
//this project shares. It was evicting pages that other objects were
//still drawing from, forcing a reload on the next frame.

/// draw the halo (protruding forward from wall)

//blend mode (neon lighting) // draw the halo (protruding forward from wall) 
if distance_to_object(obj_player_buruwasu) &lt; (global.drawOCRange / 2) 
{ 
    draw_set_color(c_yellow); 
    draw_set_blend_mode(bm_add); 
    // how far the glow sticks out from the wall 
    
    var protrude = 20; 
// calculate forward direction based on lamp rotation 
var hx = lengthdir_x(protrude, zDirection); 
var hy = lengthdir_y(protrude, zDirection); 
d3d_set_lighting(0); 
d3d_set_depth(false); 
d3d_set_zwriteenable(false); 

draw_sprite_3d( spr_halo_yellow_32_32, 0, 1.5, 1.5, x + hx, y + hy, z - 10, 0, 0, 0 ); 
d3d_set_depth(true); 
d3d_set_zwriteenable(true); 
}  
   
//reset settings
draw_set_blend_mode(bm_normal);
draw_set_color(c_white);
draw_set_alpha(1);
d3d_set_lighting(0);
       
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
