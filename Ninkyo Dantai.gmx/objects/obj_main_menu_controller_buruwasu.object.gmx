    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>//Gamepad navigation (DualSense/DualShock etc) - D-pad or left stick up/down.
//Two independent detection paths feed into one combined _wantUp/_wantDown per
//frame, so a pad recognised by BOTH paths at once (see below) only moves the
//menu one step, not two.
gamepadDevice = -1;
var _deviceCount = gamepad_get_device_count();

for (var _i = 0; _i &lt; _deviceCount; _i++)
{
    if gamepad_is_connected(_i)
    {
        gamepadDevice = _i;
        break;
    }
}

legacyJoystickId = -1;
var _lj = 1;

while _lj &lt;= 4
{
    if joystick_exists(_lj)
    {
        legacyJoystickId = _lj;
        _lj = 5;
    }
    else
    {
        _lj++;
    }
}

var _wantUp = false;
var _wantDown = false;

//Path 1: GameMaker's mapped gamepad API (works for most Xbox-layout pads, and
//for the analog stick on every pad we've tested, DualSense included).
if gamepadDevice != -1
{
    if gamepad_button_check_pressed(gamepadDevice, gp_padu)
    {
        _wantUp = true;
    }
    if gamepad_button_check_pressed(gamepadDevice, gp_padd)
    {
        _wantDown = true;
    }

    var _stickY = gamepad_axis_value(gamepadDevice, gp_axislv);

    if _stickY &lt; -0.5
    {
        if gamepadStickDir != -1
        {
            _wantUp = true;
            gamepadStickDir = -1;
        }
    }
    else if _stickY &gt; 0.5
    {
        if gamepadStickDir != 1
        {
            _wantDown = true;
            gamepadStickDir = 1;
        }
    }
    else
    {
        gamepadStickDir = 0;
    }
}

//Path 2: legacy DirectInput joystick POV hat. DualSense's D-pad over Bluetooth
//reports as a POV hat rather than the 4 discrete SDL dpad buttons Path 1
//expects, and GMS 1.4's bundled controller mapping predates the DualSense, so
//Path 1 never sees it. joystick_pov reads the hat directly, bypassing that
//mapping entirely - this also covers other pads with the same mismatch.
if legacyJoystickId != -1
{
    if joystick_has_pov(legacyJoystickId)
    {
        var _pov = joystick_pov(legacyJoystickId);

        if _pov == -1
        {
            gamepadPovDir = 0;
        }
        else
        {
            var _povUp = (_pov &gt;= 315) or (_pov &lt;= 45);
            var _povDown = (_pov &gt;= 135) and (_pov &lt;= 225);

            if _povUp
            {
                if gamepadPovDir != -1
                {
                    _wantUp = true;
                    gamepadPovDir = -1;
                }
            }
            else if _povDown
            {
                if gamepadPovDir != 1
                {
                    _wantDown = true;
                    gamepadPovDir = 1;
                }
            }
            else
            {
                gamepadPovDir = 0;
            }
        }
    }
}

if _wantUp
{
    menuChoice--;
}
if _wantDown
{
    menuChoice++;
}

if subtitleChoice == 0
{
    subtitle = "I,Md";
}

if subtitleChoice &lt; 0
{
    subtitleChoice = 0
}

if subtitleChoice &gt; 1
{
    subtitleChoice = 0
}

if menuChoice &lt; 0
{
    menuChoice = 6;
}

else if menuChoice &gt; 6
{
    menuChoice = 0;
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="64">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>draw_self();
//Create menu box
draw_set_alpha(0.8)
draw_set_color(c_black)
draw_rectangle(200,250,270+280,250+ 220,0);
draw_set_alpha(1)

scr_glow_text(240,220,"Main Menu",ft_buruwasu_gui,c_white,c_white,fa_top, fa_left,2,c_teal,1);

//menu options
if menuChoice == 0 //new game
{
    scr_glow_text(280,250 + 20,"New Game",ft_buruwasu_gui,c_white,c_white,fa_top, fa_left,2,c_teal,1);
    draw_set_color(make_colour_rgb(125,134,133));
    draw_text(250,280,string("Load Game"));
    draw_text(250,310,string("Options"));
    draw_text(250,340,string("Character Profiles"));
    draw_text(250,370,string("Downloadable Content"));
    draw_text(250,400,string("Credits"));
    draw_text(250,430,string("Quit to Desktop"));
}

else if menuChoice == 1 //load game
{
    draw_set_color(make_colour_rgb(125,134,133));
    draw_text(250,250,string("New Game"));
    scr_glow_text(280,280 + 20,"Load Game",ft_buruwasu_gui,c_white,c_white,fa_top, fa_left,2,c_teal,1);
    draw_set_color(make_colour_rgb(125,134,133));
    draw_text(250,310,string("Options"));
    draw_text(250,340,string("Character Profiles"));
    draw_text(250,370,string("Downloadable Content"));
    draw_text(250,400,string("Credits"));
    draw_text(250,430,string("Quit to Desktop"));
}

else if menuChoice == 2 //options
{
    draw_set_color(make_colour_rgb(125,134,133));
    draw_text(250,250,string("New Game"));
    draw_text(250,280,string("Load Game"));
    scr_glow_text(255,310 + 20,"Options",ft_buruwasu_gui,c_white,c_white,fa_top, fa_left,2,c_teal,1);
    draw_set_color(make_colour_rgb(125,134,133));
    draw_text(250,340,string("Character Profiles"));
    draw_text(250,370,string("Downloadable Content"));
    draw_text(250,400,string("Credits"));
    draw_text(250,430,string("Quit to Desktop"));
}

else if menuChoice == 3 //character
{
    draw_set_color(make_colour_rgb(125,134,133));
    draw_text(250,250,string("New Game"));
    draw_text(250,280,string("Load Game"));
    draw_text(250,310,string("Options"));
    scr_glow_text(320,340 + 20,"Character Profiles",ft_buruwasu_gui,c_white,c_white,fa_top, fa_left,2,c_teal,1);
    draw_set_color(make_colour_rgb(125,134,133));
    draw_text(250,370,string("Downloadable Content"));
    draw_text(250,400,string("Credits"));
    draw_text(250,430,string("Quit to Desktop"));
}

else if menuChoice == 4 //dlc
{
    draw_set_color(make_colour_rgb(125,134,133));
    draw_text(250,250,string("New Game"));
    draw_text(250,280,string("Load Game"));
    draw_text(250,310,string("Options"));
    draw_text(250,340,string("Character Profiles"));
    scr_glow_text(355,370 + 20,"Downloadable Content",ft_buruwasu_gui,c_white,c_white,fa_top, fa_left,2,c_teal,1);
    draw_set_color(make_colour_rgb(125,134,133));
    draw_text(250,400,string("Credits"));
    draw_text(250,430,string("Quit to Desktop"));
}

else if menuChoice == 5 //credits
{
    draw_set_color(make_colour_rgb(125,134,133));
    draw_text(250,250,string("New Game"));
    draw_text(250,280,string("Load Game"));
    draw_text(250,310,string("Options"));
    draw_text(250,340,string("Character Profiles"));
    draw_text(250,370,string("Downloadable Content"));
    scr_glow_text(249,400 + 20,"Credits",ft_buruwasu_gui,c_white,c_white,fa_top, fa_left,2,c_teal,1);
    draw_set_color(make_colour_rgb(125,134,133));
    draw_text(250,430,string("Quit to Desktop"));
}

else if menuChoice == 6 //quit
{
    draw_set_color(make_colour_rgb(125,134,133));
    draw_text(250,250,string("New Game"));
    draw_text(250,280,string("Load Game"));
    draw_text(250,310,string("Options"));
    draw_text(250,340,string("Character Profiles"));
    draw_text(250,370,string("Downloadable Content"));
    draw_text(250,400,string("Credits"));
    scr_glow_text(308,430 + 20,"Quit to Desktop",ft_buruwasu_gui,c_white,c_white,fa_top, fa_left,2,c_teal,1);
}

//Menu titles
draw_set_font(ft_buruwasu_title)
draw_set_color(c_white)
draw_text(1000,350,string("Ninkyo Dantai"))
draw_text(1000,400,string("Buruwasu Murder Mystery"))

draw_set_font(ft_buruwasu_subtitle)
draw_text(1000,450,string(subtitle))
draw_set_font(ft_buruwasu_gui);
draw_set_color(c_white);

//Loading indicator
if progress &gt;= 0
{
    scr_glow_text(1600,1000,string(loadingString + " &gt; " + string(progress) + "%"),ft_buruwasu_gui,c_white,c_white,fa_top, fa_left,2,c_teal,1);
}

//DEBUG: gamepad diagnostics for controller testing - remove once DualSense nav is confirmed working
draw_set_font(ft_buruwasu_gui);
draw_set_halign(fa_left);
draw_set_valign(fa_top);
draw_set_color(c_yellow);

var _deviceCount = gamepad_get_device_count();
draw_text(20,20,"Gamepad slots: " + string(_deviceCount));

var _debugY = 44;
var _di = 0;

while _di &lt; _deviceCount
{
    var _line = "Slot " + string(_di) + ": ";

    if gamepad_is_connected(_di)
    {
        _line += "CONNECTED - " + gamepad_get_description(_di);
    }
    else
    {
        _line += "not connected";
    }

    draw_text(20,_debugY,_line);
    _debugY += 24;
    _di++;
}

if gamepadDevice != -1
{
    draw_text(20,_debugY,"Active device " + string(gamepadDevice) + " | left stick Y axis: " + string(gamepad_axis_value(gamepadDevice, gp_axislv)));
}
else
{
    draw_text(20,_debugY,"No gamepad recognised by GameMaker.");
}

_debugY += 24;

if gamepadDevice != -1
{
    var _rawButtonCount = gamepad_button_count(gamepadDevice);
    var _rawAxisCount = gamepad_axis_count(gamepadDevice);
    var _bits = "";
    var _bi = 0;

    while _bi &lt; _rawButtonCount
    {
        if gamepad_button_check(gamepadDevice, _bi)
        {
            _bits += "1";
        }
        else
        {
            _bits += "0";
        }

        _bi++;
    }

    draw_text(20,_debugY,"Raw buttons (" + string(_rawButtonCount) + "): " + _bits);
    _debugY += 24;

    var _axisStr = "";
    var _ai = 0;

    while _ai &lt; _rawAxisCount
    {
        _axisStr += string(_ai) + "=" + string(gamepad_axis_value(gamepadDevice, _ai)) + " ";
        _ai++;
    }

    draw_text(20,_debugY,"Raw axes: " + _axisStr);
    _debugY += 24;
}

if legacyJoystickId != -1
{
    var _povText = "no POV";

    if joystick_has_pov(legacyJoystickId)
    {
        _povText = string(joystick_pov(legacyJoystickId));
    }

    draw_text(20,_debugY,"Legacy joystick " + string(legacyJoystickId) + " | POV: " + _povText);
}
else
{
    draw_text(20,_debugY,"Legacy joystick API: none found");
}

draw_set_color(c_white);

</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="9" enumb="40">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>menuChoice++;
</string>
          </argument>
        </arguments>
