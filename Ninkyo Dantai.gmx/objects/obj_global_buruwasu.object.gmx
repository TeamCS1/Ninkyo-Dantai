            <string>///Global Variables

//map related
global.newRoomCityBuruwasuMap = 0;
global.newRoomCityBuruwasuisGenerated = false;
global.previousLocation = rm_city_buruwasu;

//general
global.storyObjectivesController = 0;
global.weapon = 0;
global.currentRoom = room;
global.drawOCRangeBase = 750;   //the resting occlusion range
global.drawOCRange = global.drawOCRangeBase; //current range; vehicles widen it, then restore it from the base

//Scenery culling (scr_CullDistantScenery). cullRange MUST stay comfortably
//above the widest drawOCRange ever gets, because a deactivated instance
//doesn't draw either - cull closer than you draw and the world has holes in it.
global.cullSceneryEnabled = true;
global.cullRange = 2200;
global.cullStep = 256;          //how far the player moves before re-culling
global.cullLastX = -100000;
global.cullLastY = -100000;
global.cullLastRoom = -1;

//Always-on minimap (scr_DrawMinimap). minimapRange is how far from the
//player the panel shows, in world units. Its DIAGONAL has to stay inside
//cullRange (range * 1.42 &lt;= cullRange) or the corners of the panel show
//empty ground that has only been deactivated, not actually cleared.
global.minimapEnabled = true;
global.minimapSize = 220;       //panel size in GUI pixels (square)
global.minimapPad = 20;         //distance from the top-left corner
global.minimapRange = 1400;     //world units shown from centre to edge
global.minimapArrowSize = 40;   //player arrow, centre to tip, in GUI pixels.
                                //It spans about 1.7x this tall in total, so
                                //much past 55 and it starts swallowing a
                                //220px panel rather than pointing at things.
global.primaryObjective = "NONE"; 
global.secondaryObjective = 0;
global.targetedX = -1;
global.targetedY = -1; 
global.distanceToTargetSecond = 0;
global.enableBloom = false;     //enables/disables bloom
global.openMiniMap = false;

//player specific
global.freezePlayer = false;    //used in menus and map editor to prevent the player from moving!
global.enablePlayerCollisionsInWorldBuruwasu = true;
global.playerLastX = 0; //used to remember player coords
global.playerLastY = 0;
global.cameraInteriors = false; //testing the zoom out feature in Shinji's home
global.homeBuildingMode = false;

//global.currentWeaponEquipped = "None"

//Hiding elements specific
global.hideAllDebugText = 1;
global.hideAllGameElements = 0;
global.hudGameElements = 1;
global.hudGameElementsAlphaControl = 1;
global.isMenuMouseScrolling = 0;

//quality settings
global.treeQuality = 3;
global.buildingQuality = 3;
global.propsQuality = 3;
global.propsSimpleQuality = 3;
global.roadInfrastructureQuality = 3;
global.waterQuality = 3;
global.environmentQuality = 3;
global.terrainQuality = 3;

//car specific
global.carZooming = true;

//vending machines
enum vendingcolors 
{
    red,
    blue,
    yellow,
    green,
    purple,
    grey
}

//debug
global.debugActive = false; //Used for interaction, vending etc

display_set_gui_size(1920, 1080);

</string>
