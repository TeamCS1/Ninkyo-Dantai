        <arguments>
          <argument>
            <kind>1</kind>
            <string>if global.hideAllGameElements == false
{
    draw_set_font(ft_buruwasu_gui);
    draw_set_halign(fa_left);
    draw_set_color(c_white)
    draw_set_alpha(global.hudGameElementsAlphaControl);
    draw_text(1450, 100, "¥" + string(floor(global.yenAmount)));
    draw_text(1450, 40, "Compass: " + string(global.compassDirection) + "° " + global.compassDirectionString)
    
    draw_set_font(ft_economica);
    draw_set_color(c_white)
   
    var hrs = string(floor(global.timeHour / 10)) + string(global.timeHour mod 10);

    var mins;
    if (global.timeMinutes &lt; 10)
    {
        mins = "0" + string(global.timeMinutes);
    }
    else
    {
        mins = string(global.timeMinutes);
    }

    draw_text(1300, 150, hrs + ":" + mins);
    
    
    
    
    
    //Health Bar
    global.currentHealthBar = (global.currentHealthCount / global.currentHealthMaximum) * 100;
    
    draw_healthbar(view_xport[0] + 1300, view_yport[0] + 120, view_xport[0] + 1400, view_yport[0] + 125 //part after view for x controls start/end point.   Second part y controls how far down in pixels.
    ,global.currentHealthBar,make_color_rgb(0,64,128),c_black,c_red,0,1,1);
    
    //STAMINA Bar
    global.currentStaminaBar = (global.currentStaminaCount / global.currentStaminaMaximum) * 100;
    
    draw_healthbar(view_xport[0] + 1300, view_yport[0] + 110, view_xport[0] + 1400, view_yport[0] + 115 //part after view for x controls start/end point.   Second part y controls how far down in pixels.
    ,global.currentStaminaBar,make_color_rgb(0,64,128),c_black,make_color_rgb(219, 165, 32),0,1,1);
    
    draw_set_alpha(1);
}

//Debug Use Only
if global.hideAllDebugText == false
{ 
    draw_set_font(ft_buruwasu_gui);
    draw_set_color(c_white);

    var roomname = room_get_name(room);
    draw_text(20,10, "Scene: " + string(roomname));

    draw_text(20,40, "Start Fog Render: " +  string(global.startFog));
    draw_text(20,70, "End Fog Render: " + string(global.endFog));
    draw_text(20, 100, "FPS Real: " +  string(fps_real) + " FPS Cap: " + string(fps));
    draw_text(20, 130, "Mouse X:" + string(mouse_x) + " Mouse Y:" +  string(mouse_y));
    draw_text(20, 160, "Camera Height: " + string(obj_control.z));
    draw_text(20, 190, "Player X: " + string(obj_player_buruwasu.x) + "Y: " + string(obj_player_buruwasu.y));

    draw_text(20, 220, "Camera X: " + string(obj_control.vector_x));
    draw_text(20, 250, "Camera Y: " + string(obj_control.vector_y));
    draw_text(20, 280, "Camera Z: " + string(obj_control.vector_z));
    draw_text(20, 310, "Total Objects " + string(instance_count));
    draw_text(20, 340, "Total NPC's: " + string(instance_number(obj_humanNPC_generic_parent)));
    draw_text(20, 370, "Do Collisions?: " + string(global.enablePlayerCollisionsInWorldBuruwasu));
    draw_text(20,400,"RAM Installed: " + string(ram_installed()/1024/1024)+" MB");
    draw_text(20, 430, "Game Memory Usage (Legacy): " + string(cleanmem_get_mem() / 1048576) +  "MB");
    draw_text(20,460,"Game Memory Usage: " + string(ram_application()/1024/1024)+" MB");
    draw_text(20,490,"System Memory Usage: " + string(ram_used()/1024/1024)+" MB");
    draw_text(20,520,"System Memory Available: " + string(ram_available()/1024/1024)+" MB"); 
    draw_text(20, 550, "Fog Red: " + string(global.fogR));
    draw_text(20, 580, "Fog Blue: " + string(global.fogB));
    draw_text(20, 610, "Fog Green: " + string(global.fogG));
    draw_text(20, 640, "Camera Z to Be: " + string(obj_control.ztobe));
    draw_text(20, 670, "Camera Z: " + string(obj_control.z));
    draw_text(20, 700, "Bearing: " + string(obj_control.bearing));
    draw_text(20, 730, "Player Direction: " + string(obj_player_buruwasu.direction));
    draw_text(20, 760, "Number of Collectables: " + string(instance_number(obj_prayer_shrine_collectible)));


    
}

