        <arguments>
          <argument>
            <kind>1</kind>
            <string>zIsTwoPoints = false; //used for map editor
z = 0;
doVendingMachineInteraction = false;

BLOCKMOD = d3d_model_create()
d3d_model_block(BLOCKMOD,-32,-32,z + 0,16,16,z + 128,1,1)
BLOCKMOD2 = d3d_model_create()
d3d_model_block(BLOCKMOD2,-32,-32,z + 128,16,16,z + 132,1,1,)

//texture management
var vendingType = choose(0, 1, 2, 3, 4, 5, 6);

TEX1 = sprite_get_texture(spr_vending_machine_buruwasu,vendingType);
TEX2 = sprite_get_texture(spr_vending_machine_buruwasu_roof,0);

//d3d_model_block(BLOCKMOD,-64,64,0,64,64,256,1,1) - This creates a 2D face texture
</string>
