        <arguments>
          <argument>
            <kind>1</kind>
            <string>if distance_to_object(obj_player_buruwasu) &lt;= 16 &amp;&amp; doVendingMachineInteraction == false
{
    draw_set_font(ft_buruwasu_gui);
    draw_set_halign(fa_left);
    draw_text_shadow_tooltips(string("I - Use Vending Machine"),ft_buruwasu_gui,3,c_black,c_blue,c_white,1.0,1.0);
}

else if distance_to_object(obj_player_buruwasu) &lt;= 16 &amp;&amp; doVendingMachineInteraction == true
{
    global.hideAllGameElements = true;  //hide the game elements
    draw_set_font(ft_buruwasu_gui);
    draw_set_halign(fa_left);
    draw_text_shadow_tooltips(string("I - Exit Vending Machine"),ft_buruwasu_gui,3,c_black,c_blue,c_white,1.0,1.0);
}

if doVendingMachineInteraction == true 
{
    draw_sprite(spr_vending_machine_user_interface_buruwasu,0,0,0);
    draw_text_shadow(1600,25,"¥" + string(floor(global.yenAmount)),ft_buruwasu_gui,3,c_white,c_black,c_black,1.0,1.0);
}
</string>
          </argument>
