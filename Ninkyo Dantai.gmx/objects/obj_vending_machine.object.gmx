    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if keyboard_check_released(ord('I')) &amp;&amp; distance_to_object(obj_player_buruwasu) &lt;= 16 &amp;&amp; global.debugActive == false &amp;&amp; doVendingMachineInteraction == false
{
    ///Vending Machine Builder
    keyboard_clear((ord('I')));
    doVendingMachineInteraction = true;
    global.freezePlayer = true;
    global.isMenuMouseScrolling = 1; //enable vending scrolling
    global.hideAllGameElements = true;  //hide the game elements
    
    //create the slots
    if !instance_exists(obj_property_management_make_inventory)
    {
        instance_create(0,0,obj_property_management_make_inventory);
    }
    
    //create the slots
    if !instance_exists(obj_vending_machine_ui)
    {
        instance_create(0,0,obj_vending_machine_ui);
    }

    
}

if distance_to_object(obj_player_buruwasu) &lt;= 16 &amp;&amp; keyboard_check_released(ord('I')) &amp;&amp; global.debugActive == true
{
    if !instance_exists(obj_notification_system_out)
    {
        scr_CreateNotifications("You can't use the vending machine at this time.",300);
    }
}

//Destroy the vending machine
if keyboard_check_released(ord('I')) &amp;&amp; doVendingMachineInteraction == true
{
    doVendingMachineInteraction = false;
    global.hideAllGameElements = false; //show the game elements
    global.isMenuMouseScrolling = 0; // disable scrolling
    global.freezePlayer = false;
    keyboard_clear((ord('I')));
    
    //destroy instances
    if instance_exists(obj_scrollbar_black_market)
    {
        with obj_scrollbar_black_market
        {
            instance_destroy();
        } 
    }
    
    if instance_exists(obj_property_management_slots)
    {
        with obj_property_management_slots
        {
            instance_destroy();
        } 
    }
    
    if instance_exists(obj_property_management_make_inventory)
    {
        with obj_property_management_make_inventory
        {
            instance_destroy();
        } 
    }
    
    if instance_exists(obj_vending_machine_ui)
    {
        with obj_vending_machine_ui
        {
            instance_destroy();
        } 
    }   
}


</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="64">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
