<!--This Document is generated by GameMaker, if you edit it by hand then you do so at your own risk!-->
<object>
  <spriteName>&lt;undefined&gt;</spriteName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>-100</depth>
  <persistent>0</persistent>
  <parentName>&lt;undefined&gt;</parentName>
  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>c_input="/";

c_cursor = '_' //Change for the symbol you want. That 3 lines handle the cursor.
flash = 0 //boolean
alarm[0] = 20;

linked_object = noone //The object we will send an input.
max_string = 0 //Max length of string, will be set by the script: scr_call_input(...)
keyboard_string = "/";

showHelp = false;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="2" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>//A simple alarm loop to make the cursor flash.
flash = !flash;

if flash
{
    c_cursor = ' ';
}
else
{
    c_cursor = '_';
}

alarm[0] = 20;

</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>//To interrupt the input.
if keyboard_check_pressed(vk_escape)
{
    global.debugModeEnablerBuruwasu = "";
    io_clear();
    obj_buruwasu_debug_console.openPopup = false;
    global.freezePlayer = false;
    global.debugActive = false;
    instance_destroy();
}

if string_length(keyboard_string) &gt; max_string
{
    keyboard_string = string_copy(keyboard_string, 1, max_string); //That prevents the string from being too long.
}

if keyboard_check_pressed(vk_enter) //When enter is pressed, the string is copied and then we process commands
{
    var cmd = string_replace_all(keyboard_string, "#", "\#");

    linked_object.receive_input = true;
    global.debugModeEnablerBuruwasu = cmd;
    obj_buruwasu_debug_console.openPopup = false;
    global.debugActive = false;

    //information is passed. Destroy obj_input.
    //io_clear()
    //instance_destroy();

    if cmd == "/list" || cmd == "/help"
    {
        showHelp = true;
    }

    else if cmd == "/time set day"
    {
        global.timeHour = 12;
        global.timeMinutes = 0;
        global.timeSeconds = 0;

        global.startFog = 1200;
        global.endFog = 1200;
        scr_ClockControl(global.timescaleSaved, 60); 
    }

    else if cmd == "/time set night"
    {
        global.timeHour = 22;
        global.timeUnitHour = 0;
        global.timeMinutes = 0;
        global.timeSeconds = 0;

        global.startFog = -2400;    //fog is used for the overall brightness of the game screen
        global.endFog = 1200;
        scr_ClockControl(global.timescaleSaved, 60); 
    }

    else if cmd == "/mute true"
    {
        audio_pause_all();
    }

    else if cmd == "/mute false"
    {
        audio_resume_all();
    }

    else if cmd == "/bloom true"
    {
        global.test = true;
    }

    else if cmd == "/bloom false"
    {
        global.test = false;
    }

    else if cmd == "/map editor true"
    {
        global.hideAllGameElements = true;

        if !instance_exists(obj_map_editor_controller)
        {
            instance_create(x, y, obj_map_editor_controller);
        }

        show_debug_message("LOG: " + "Map Editor is now active. Awaiting Input...");
        show_debug_message("LOG: " + "Press F2 to start searching for Objects.");
    }

    else if cmd == "/map editor false"
    {
        with (obj_map_editor_controller)
        {
            instance_destroy();
        }

        //reset map editor back to game
        global.hideAllGameElements = false;
        window_set_caption("Ninkyo Dantai");
    }

    else if cmd == "/map"
    {
        instance_create(0,0,obj_debug_map_mode);
    }

    else if cmd == "/physics"
    {
        if global.debugVehiclePhysics == true
        {
            global.debugVehiclePhysics = false;
            show_debug_message("LOG: " + "Vehicle physics overlay OFF");
        }
        else
        {
            global.debugVehiclePhysics = true;
            show_debug_message("LOG: " + "Vehicle physics overlay ON - get in a vehicle to see it");
        }
    }

    else if cmd == "/teleport"
    {
        var xx = get_integer("Enter x", 500);
        var yy = get_integer("Enter Y", 500);

        // If you actually want to move something, uncomment what you need:
        obj_player_buruwasu.x = xx;
        obj_player_buruwasu.y = yy;
        obj_control.x = xx;
        obj_control.y = yy;
    }

    else if cmd == "/enablecoll 0"
    {
        global.enablePlayerCollisionsInWorldBuruwasu = false;
    }

    else if cmd == "/enablecoll 1"
    {
        global.enablePlayerCollisionsInWorldBuruwasu = true;
    }

    else if cmd == "/mall"
    {
        cleanmem(); //clean memory
        room_goto(rm_city_buruwasu_mordern_mall);
    }

    else if cmd == "/timescale"
    {
        global.timescale = 10000;
    }

    else if cmd == "/template"
    {
        cleanmem(); //clean memory
        room_goto(rm_template_test);
    }

    else if cmd == "/chicken"
    {
        cleanmem(); //clean memory
        room_goto(rm_chicken_licken);
    }

    else if cmd == "/home"
    {
        cleanmem(); //clean memory
        room_goto(rm_ShinjiHome);
    }

    else if cmd == "/yokyohama"
    {
        cleanmem(); //clean memory
        room_goto(rm_city_yokyohama);
    }

    else if cmd == "/end"
    {
        cleanmem(); //clean memory
        game_end();
    }

    else if cmd == "/get weekday"
    {
        show_message("Day: " + string(global.newWeekString)+ "#Index: " + string(global.daysOfWeekIndex));
    }

    else
    {
        keyboard_string = "/";
        global.freezePlayer = true;
        obj_buruwasu_debug_console.openPopup = true;
        //show_message("Command not found. For a full command list, type /list");
    }
}

// Keep c_input updated (optional, for display/debug purposes)
c_input = string_replace_all(keyboard_string, "#", "\#");

</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="75">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>draw_set_valign(fa_top);
draw_set_halign(fa_left);
draw_set_font(ft_map_editor_buruwasu);
    
draw_text(x,y + 70,string("Debug Command Console: "));
draw_text(x,y + 100,string(c_input) + c_cursor); //This is what is typed.

if showHelp == true
{
    scr_glow_text(x + 100,y+140,"Found 10 commands",ft_map_editor_buruwasu,c_white,c_white,fa_top, fa_left,2,c_teal,1);
    draw_text(x,y + 160,string("/time set day"));
    draw_text(x,y + 190,string("/time set night"));
    draw_text(x,y + 220,string("/mute &lt;bool&gt;"));
    draw_text(x,y + 250,string("/bloom &lt;bool&gt;"));
    draw_text(x,y + 280,string("/map editor &lt;bool&gt;"));
    draw_text(x,y + 310,string("/enablecoll &lt;bool&gt;"));
    draw_text(x,y + 340,string("/timescale"));
    draw_text(x,y + 370,string("/mall"));
    draw_text(x,y + 400,string("/template"));
    draw_text(x,y + 430,string("/physics"));
}



</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
  <PhysicsObject>0</PhysicsObject>
  <PhysicsObjectSensor>0</PhysicsObjectSensor>
  <PhysicsObjectShape>0</PhysicsObjectShape>
  <PhysicsObjectDensity>0.5</PhysicsObjectDensity>
  <PhysicsObjectRestitution>0.100000001490116</PhysicsObjectRestitution>
  <PhysicsObjectGroup>0</PhysicsObjectGroup>
  <PhysicsObjectLinearDamping>0.100000001490116</PhysicsObjectLinearDamping>
  <PhysicsObjectAngularDamping>0.100000001490116</PhysicsObjectAngularDamping>
  <PhysicsObjectFriction>0.200000002980232</PhysicsObjectFriction>
  <PhysicsObjectAwake>-1</PhysicsObjectAwake>
  <PhysicsObjectKinematic>0</PhysicsObjectKinematic>
  <PhysicsShapePoints/>
</object>
