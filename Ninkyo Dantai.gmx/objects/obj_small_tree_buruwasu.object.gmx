    draw_set_alpha(1)
    
    d3d_transform_set_identity();
    d3d_transform_add_scaling(10,10,10);
    d3d_transform_add_rotation_z(zDirection);
    d3d_transform_add_translation(x, y, z);
    d3d_model_draw(tree, 0, 0, 0, sprite_get_texture(uv_tree001,0));
    //d3d_set_culling(0);
    d3d_transform_set_identity();
}

else
{
    sprite_flush(uv_tree001);
}
