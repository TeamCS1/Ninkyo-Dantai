        <arguments>
          <argument>
            <kind>1</kind>
            <string>if point_distance(x, y, global.playerX, global.playerY) &lt; global.drawOCRange
{
    //make sure drawing colors are reset to white
    draw_set_color(c_white);
    //turn on texture repeating so our UV's work right
    texture_set_repeat(true);
    d3d_set_lighting(1); //enable lighting
    draw_set_alpha(1);
    d3d_transform_add_scaling(0.25, 0.25, 0.25);
    d3d_transform_add_rotation_z(0);
    d3d_transform_add_translation(x, y, z);
    
    switch(global.propsQuality)
    {
        case 1 :
            d3d_model_draw(bin, 0, 0, 0, sprite_get_texture(uv_bin_ashtray_buruwasu_64_64,0));
            break;
        case 2 :
            d3d_model_draw(bin, 0, 0, 0, sprite_get_texture(uv_bin_ashtray_buruwasu_128_128,0));
            break;
        case 3 :
            d3d_model_draw(bin, 0, 0, 0, sprite_get_texture(uv_bin_ashtray_buruwasu_256_256,0));
            break;
        case 4 :
            d3d_model_draw(bin, 0, 0, 0, sprite_get_texture(uv_bin_ashtray_buruwasu_512_512,0));
            break;
        case 5 :
            d3d_model_draw(bin, 0, 0, 0, sprite_get_texture(uv_bin_ashtray_buruwasu_1024_1024,0));
            break;
    }
    
    //reset settings
    draw_set_alpha(1);
    d3d_set_lighting(0);
    d3d_transform_set_identity();
    //scr_DrawCollisionBoxModel(c_red,0,64)
}

else
{
    sprite_flush(uv_bin_ashtray_buruwasu_1024_1024);
    sprite_flush(uv_bin_ashtray_buruwasu_512_512);
    sprite_flush(uv_bin_ashtray_buruwasu_256_256);
    sprite_flush(uv_bin_ashtray_buruwasu_128_128);
    sprite_flush(uv_bin_ashtray_buruwasu_64_64);
}

draw_set_alpha(1);
//draw_rectangle_colour(bbox_left,bbox_top,bbox_right,bbox_bottom,c_red,c_red,c_red,c_red,false);
</string>
          </argument>
