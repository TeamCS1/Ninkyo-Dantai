    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if global.storyObjectivesController == 0
{
    if global.hasCollidedWithGunShopMarker == false
    {
        if !instance_exists(obj_gun_shop_corona_shine_of_light) &amp;&amp; instance_exists(obj_gun_shop_shine_of_light_gui)
        {
            global.hasCollidedWithGunShopMarker = true
        }
    
        if instance_exists(obj_gun_shop_corona_shine_of_light)
        {
            ex = instance_nearest(x, y, obj_gun_shop_corona_shine_of_light.x);
            ey = instance_nearest(x, y, obj_gun_shop_corona_shine_of_light.y);
            global.primaryObjective = "Go to the gun store";
    
            global.distanceToTarget = point_distance(obj_player_buruwasu.x, obj_player_buruwasu.y, obj_gun_shop_corona_shine_of_light.x, obj_gun_shop_corona_shine_of_light.y) / waypointPrecision;
        }
    }
    
    else if global.hasCollidedWithGunShopMarker == true
    {
        global.storyObjectivesController = 1;   
    }
}

else if global.storyObjectivesController == 1
{
    if instance_exists(obj_gun_shop_corona_shine_of_light)
        {
            ex = instance_nearest(x, y, obj_gun_shop_corona_shine_of_light.x);
            ey = instance_nearest(x, y, obj_gun_shop_corona_shine_of_light.y);
            global.primaryObjective = "You are free to explore the City.";   
            global.distanceToTarget = 0;
        }
}

//This section controls the optional objective
if global.secondaryObjective == 1
{
    if !instance_exists(obj_custom_waypoint_buruwasu)
    {
        //find where to place marker
        targetedXReal = global.targetedX * 25000 / 3500; 
        targetedYReal = global.targetedY * 25000 / 4800;
        instance_create(targetedXReal,targetedYReal,obj_custom_waypoint_buruwasu)
    }
    
    if instance_exists(obj_custom_waypoint_buruwasu)
    {
        var ex2, ey2;
    
        ex2 = instance_nearest(x, y, obj_custom_waypoint_buruwasu.x);
        ey2 = instance_nearest(x, y, obj_custom_waypoint_buruwasu.y);

        global.distanceToTargetSecond = point_distance(obj_player_buruwasu.x, obj_player_buruwasu.y, obj_custom_waypoint_buruwasu.x, obj_custom_waypoint_buruwasu.y) / waypointPrecision;
    }
    
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
