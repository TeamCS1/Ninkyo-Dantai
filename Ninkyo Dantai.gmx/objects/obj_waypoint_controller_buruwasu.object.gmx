            <string>if global.hideAllGameElements == false
{
    draw_set_halign(fa_center);
    draw_text_shadow(window_get_width() / 2, 20, string(global.primaryObjective) + " (Story) " + string(global.distanceToTarget) + "m",ft_buruwasu_gui,3,c_black,c_blue,c_white,1.0,1.0);
    
    if global.targetedX &gt;= 0 &amp;&amp; global.targetedY &gt;= 0
    {
        draw_text_colour(window_get_width() / 2, 60, string( " (Personal)") + string(global.distanceToTargetSecond) + "m",c_red,c_white,c_red,c_white,1)
    }
}
</string>
          </argument>
