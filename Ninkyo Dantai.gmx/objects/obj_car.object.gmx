            <kind>1</kind>
            <string>image_speed = 0;

scr_VehicleCreateEventBuruwasu(id, 6, -2, 0.7, 0.050, 0.01, 0.05, "Block,Charger", 3);

// Custom physics velocity
vx = 0;
vy = 0;

// Handling values
grip = 0.12;           // how quickly the car regains traction and stops sideways sliding
driftGrip = 0.035;     // reduced traction applied while handbraking to allow controlled drifting
drag = 0.985;          // natural rolling resistance that slowly reduces overall momentum
brakePower = 0.12;     // braking force applied when slowing down from forward movement
handbrakePower = 0.965; // percentage of momentum preserved each frame while handbraking

fakeSpeed = 0;
toDrawCarName = false;
gearNumber = "1";
needleRot = 25;

alarm[0] = room_speed * 0.1;
</string>
          </argument>
        </arguments>
      </action>
