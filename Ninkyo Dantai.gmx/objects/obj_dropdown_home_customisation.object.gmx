        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// PRESSED EVENT LISTENER

// Get the mouse coordinates relative to the window
var mouseX = window_mouse_get_x();
var mouseY = window_mouse_get_y();

// Check if the mouse coordinates meet the position of the button
if (position_meeting(mouseX, mouseY, id)) 
{
    //Code for clicking - 
    itemEntered = id; 

    with itemEntered
    {
        if (mouse_check_button_released(mb_left)) 
        {
        
        ///Create Dropdown Labels
        scr_CreateDropdownItems();
        
        
        
            if (dropdown_visible) 
            {
                obj_dropdown_slots.x = -5000; // Hide the dropdown
            } else 
            {
                obj_dropdown_slots.x = 1500; // Show the dropdown
            }
            
        // Toggle the state
        dropdown_visible = !dropdown_visible;
        }    
    }         
} 
else 
{
    // Mouse is outside the button
    // Add your code for when the mouse is not hovering over the button
    image_index = 0;
}

/*TODO:  FOR NOT ENOUGH FUNDS
if !instance_exists(obj_notification_system_out)
    {
        scr_CreateNotifications("You have int with Vending",300);
    } 
</string>
          </argument>
        </arguments>
      </action>
