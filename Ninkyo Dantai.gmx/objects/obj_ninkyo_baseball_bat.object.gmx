        <arguments>
          <argument>
            <kind>1</kind>
            <string>zIsTwoPoints = false; //used for map editor
z = 64;
zDirection = 0;
weapon = scr_load_model(working_directory + "Assets\Buruwasu\mdl_baseball_bat_ninkyo.d3d");

//bobbing
doBobbing = true;
bobbingSpeed = 1;
MaxDistance = 100;

//setup collisions
image_xscale = 1.0;
image_yscale = 1.0;
</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>BLOCKMOD = d3d_model_create();
d3d_model_cylinder(BLOCKMOD,-20, -20, -20, 20, 20, 20, 1, 1, true, 24);
TEX1 = sprite_get_texture(spr_coronas,0);

</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
