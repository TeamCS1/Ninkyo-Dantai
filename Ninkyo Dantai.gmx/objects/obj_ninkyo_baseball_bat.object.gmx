        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>zDirection--;


</string>
          </argument>
        </arguments>
      </action>
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Weapon Bobbing
if doBobbing == true
{
    bobbingSpeed = 0.5;
    z += bobbingSpeed;

    //If it's moved to or past the max distance
    if z &gt; MaxDistance
    {
        doBobbing = false;
        z = MaxDistance; 
        //show_debug_message("do bobbing is false");
    }
}

else if doBobbing == false
{
    bobbingSpeed = 0.5;
    z -= bobbingSpeed;
    
    if z &lt; 64
    {
        z = 64;
        doBobbing = true;
    }
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if point_distance(x, y, global.playerX, global.playerY) &lt; global.drawOCRange
{
    draw_set_color(c_white);
    draw_set_alpha(1);
    draw_set_alpha_test(false);
    d3d_model_draw(BLOCKMOD,x,y,0,TEX1);
}


if point_distance(x, y, global.playerX, global.playerY) &lt; global.drawOCRange
{
    //make sure drawing colors are reset to white
    draw_set_color(c_white);
    //turn on texture repeating so our UV's work right
    texture_set_repeat(1);
    //d3d_set_culling(0);
    d3d_set_lighting(0) //make sure house lighting is false. Somehow lighting works when off lmao 
    
    d3d_transform_set_scaling(1,1,1);
    d3d_transform_add_rotation_z(zDirection);
    d3d_transform_add_translation(x, y, z);
    d3d_set_lighting(1);
    
    switch(global.propsQuality)
    {
        case 1 :
            d3d_model_draw(weapon, 0, 0, 0, sprite_get_texture(uv_baseball_bat_64_64_ninkyo,0));
            break;
        case 2 :
            d3d_model_draw(weapon, 0, 0, 0, sprite_get_texture(uv_baseball_bat_128_128_ninkyo,0));
            break;
        case 3 :
            d3d_model_draw(weapon, 0, 0, 0, sprite_get_texture(uv_baseball_bat_256_256_ninkyo,0));
            break;
        case 4 :
            d3d_model_draw(weapon, 0, 0, 0, sprite_get_texture(uv_baseball_bat_512_512_ninkyo,0));
            break;
        case 5 :
            d3d_model_draw(weapon, 0, 0, 0, sprite_get_texture(uv_baseball_bat_1024_1024_ninkyo,0));
            break;
    }
    
    //d3d_set_culling(0);
    d3d_set_lighting(0);
    draw_set_alpha(1)
    d3d_transform_set_identity();
}

else
{
    sprite_flush(uv_baseball_bat_1024_1024_ninkyo);
    sprite_flush(uv_baseball_bat_512_512_ninkyo);
    sprite_flush(uv_baseball_bat_256_256_ninkyo);
    sprite_flush(uv_baseball_bat_128_128_ninkyo);
    sprite_flush(uv_baseball_bat_64_64_ninkyo);
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
