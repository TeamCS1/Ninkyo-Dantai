            <string>if y &gt;= scrollCutOff &amp;&amp; y &lt;= 980
{
    draw_sprite(spr_vending_machine_slot_button,image_index,x,y);
}

//set text properties
draw_set_font(ft_vending_gui);
draw_set_color(c_black);
draw_set_valign(fa_center);

//Normal properties

if(printOut)
{
    if y &gt;= scrollCutOff &amp;&amp; y &lt;= 980
    {
        draw_text_transformed_colour(x + 8,y + 12,name,1,1,0,c_white,c_white,c_white,c_white,1);
        draw_set_halign(fa_right);
        draw_text_transformed_colour(x + 835,y + 25,"¥" + string(scr_number_sep(price,",",3)),1,1,0,c_white,c_white,c_white,c_white,1);
        draw_text_transformed_colour(x + 680,y + 25,"x " + string(quantity) + " / 32",1,1,0,c_white,c_white,c_white,c_white,1);
        draw_set_halign(fa_left);
    }
}

else
{
