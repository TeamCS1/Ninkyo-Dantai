            <kind>1</kind>
            <string>/// PRESSED EVENT LISTENER

// Get the mouse coordinates relative to the window
var mouseX = window_mouse_get_x();
var mouseY = window_mouse_get_y();

// Check if the mouse coordinates meet the position of the button
if (position_meeting(mouseX, mouseY, id)) 
{
    // Mouse is inside the button
    // Add your code for mouse hover behavior here
    image_index = 1;
    show_debug_message("Yes")
   
    //Code for clicking - 
    itemEntered = id; 

with itemEntered
{

    obj_vending_machine_ui.name = itemEntered.name;
    obj_vending_machine_ui.desc = itemEntered.desc;
    obj_vending_machine_ui.price = itemEntered.price;

     //obj_properties_new_york_menu_pointer.newYorkPropertySelection = itemEntered.name;
     //global.newYorkPropertySelection = itemEntered.name; 
     //obj_properties_new_york_menu_pointer.propertyDescription = itemEntered.desc;
     //obj_properties_new_york_menu_pointer.propertyCost = itemEntered.price;
     //obj_properties_new_york_menu_pointer.propertyUpkeepType = itemEntered.upkeep;
     //obj_properties_new_york_menu_pointer.propertyQuantity = itemEntered.quantity;
}    
    
    
} 
else 
{
    // Mouse is outside the button
    // Add your code for when the mouse is not hovering over the button
    image_index = 0;
}

