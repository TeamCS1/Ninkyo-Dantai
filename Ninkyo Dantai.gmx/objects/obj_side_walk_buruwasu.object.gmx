        <arguments>
          <argument>
            <kind>1</kind>
            <string>//randomize() used to be here. This object has 2,029 instances in the
//spawn room, so that was 2,029 reseeds of the RNG at room load -
//randomize() is meant to be called once. obj_global_buruwasu does it
//now, before any of these are created.
rotation = 0;
z = 0;

//choose pavement type
choice = choose(0,1);

tex = sprite_get_texture(spr_sidewalk3d,choice);

image_speed = 0.0;
noOfCones = -1;

//if pavement is broken, create cones
if choice == 69
{
    noOfCones = choose(1,2,3)
    
    if noOfCones == 1
    {
        instance_create(x + 64,y + 114,obj_cone_buruwasu)
    }
    
    else if noOfCones == 2
    {
        instance_create(x + 64,y,obj_cone_buruwasu)
        instance_create(x,y + 64,obj_cone_buruwasu)
    }
    
    else if noOfCones == 3
    {
        instance_create(x + 64,y - 114,obj_cone_buruwasu)
        instance_create(x,y + 64,obj_cone_buruwasu)
        instance_create(x,y - 64,obj_cone_buruwasu)
    }
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="0">
      <action>
        <libid>1</libid>
