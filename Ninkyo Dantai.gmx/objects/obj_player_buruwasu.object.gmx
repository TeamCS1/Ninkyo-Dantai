<object>
  <spriteName>spr_player</spriteName>
  <solid>0</solid>
  <visible>-1</visible>
  <depth>1</depth>
  <persistent>0</persistent>
  <parentName>&lt;undefined&gt;</parentName>
  <maskName>mask_player</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>//record player position
global.playerX = obj_player_buruwasu.x;
global.playerY = obj_player_buruwasu.y;

image_speed=0
speed=0
coneColl = false;
keyboard_set_map(ord('W'),vk_up)
keyboard_set_map(ord('A'),vk_left)
keyboard_set_map(ord('D'),vk_right)
keyboard_set_map(ord('S'),vk_down)
keyboard_set_map(vk_lshift,vk_rshift)
//keyboard_set_map(ord('F'),vk_return)

global.inVehicle = false;
//Others

global.carIconGlobalX = 0
global.carIconGlobalY = 0

global.playerTempLocX = 0
global.playerTempLocY = 0

global.carGlobalX = 0
global.carGlobalY = 0
global.toSwitchPhysics = false
global.currentRoom = room;

global.distanceToTarget = 0;
global.compassDirection = direction;
global.compassDirectionString = "";

alarm[0] = room_speed * 1;

if !instance_exists(obj_waypoint_controller_buruwasu)
{
    instance_create(x,y,obj_waypoint_controller_buruwasu)
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="2" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Shrine check, runs every second

if room == rm_city_buruwasu
{
    var foundShrine = scr_check_nearby_shrines();
    
    if (foundShrine != -1) 
    {
        obj_prayer_shrine_collectible.doPrayerShrineInteraction = true;
        obj_prayer_shrine_collectible.shrineIndex = foundShrine;
    } 
    
    else 
    {
        obj_prayer_shrine_collectible.doPrayerShrineInteraction = false;
    }
}

alarm[0] = room_speed * 1;
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>//record player position
global.playerX = obj_player_buruwasu.x;
global.playerY = obj_player_buruwasu.y;

image_angle = direction;
global.compassDirection = direction;

if speed &gt; 1
{
    image_speed = 0.125
    global.yenAmount += 0.25
}

else
image_speed = 0

//Facing East
if global.compassDirection &gt; 0 &amp;&amp; global.compassDirection &lt; 44
{
    global.compassDirectionString = "East"
}

//Facing north East
if global.compassDirection &gt; 45 &amp;&amp; global.compassDirection &lt; 89
{
    global.compassDirectionString = "North East"
}

//Facing north
if global.compassDirection &gt; 90 &amp;&amp; global.compassDirection &lt; 134
{
    global.compassDirectionString = "North"
}

//Facing north west
if global.compassDirection &gt; 135 &amp;&amp; global.compassDirection &lt; 179
{
    global.compassDirectionString = "North West"
}

//Facing west
if global.compassDirection &gt; 180 &amp;&amp; global.compassDirection &lt; 224
{
    global.compassDirectionString = "West"
}

//Facing west
if global.compassDirection &gt; 225 &amp;&amp; global.compassDirection &lt; 269
{
    global.compassDirectionString = "South West"
}

//Facing west
if global.compassDirection &gt; 270 &amp;&amp; global.compassDirection &lt; 314
{
    global.compassDirectionString = "South"
}

//Facing west
if global.compassDirection &gt; 315 &amp;&amp; global.compassDirection &lt; 360
{
    global.compassDirectionString = "South East"
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
