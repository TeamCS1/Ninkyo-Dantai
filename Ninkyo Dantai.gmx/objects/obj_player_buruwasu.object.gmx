        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if global.freezePlayer == false 
&amp;&amp; global.homeBuildingMode == false
{
    if speed &lt; 5 
    {
        speed += 0.2;
        friction = 0;
    }
}

if global.homeBuildingMode == true
{
    y -= 24;
}


</string>
          </argument>
        </arguments>
      </action>
    </event>
