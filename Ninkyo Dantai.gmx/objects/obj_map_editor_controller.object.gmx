        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// Win Menu
// obj_menu - Create Event

// Initialize the menu bar
global.my_menu_bar = winmenu_create_bar();

// Create the File menu
var file_menu = winmenu_create_popup();
winmenu_add(file_menu, 1, "New");
winmenu_add(file_menu, 2, "Open");
winmenu_add(file_menu, 3, "Save");
winmenu_add_separator(file_menu, 4);
winmenu_add(file_menu, 5, "Exit");

// Create the Options menu
var options_menu = winmenu_create_popup();
winmenu_add(options_menu, 6, "Sound");
winmenu_add(options_menu, 7, "Help");

// Create the Edit menu
var edit_menu = winmenu_create_popup();

// Create the Pixel Spacing submenu
var pixel_spacing_menu = winmenu_create_popup();
winmenu_add(pixel_spacing_menu, 34, "Custom");
winmenu_add_separator(pixel_spacing_menu, 35);
winmenu_add(pixel_spacing_menu, 36, "1");
winmenu_add(pixel_spacing_menu, 37, "16");
winmenu_add(pixel_spacing_menu, 38, "32");
winmenu_add(pixel_spacing_menu, 39, "64");
winmenu_add(pixel_spacing_menu, 40, "100");

// Add Pixel Spacing submenu to Edit menu
winmenu_add_submenu(edit_menu, 33, pixel_spacing_menu, "Pixel Spacing");

// Add menus to the menu bar
winmenu_add_submenu(global.my_menu_bar, 0, file_menu, "File");  // File menu
winmenu_add_submenu(global.my_menu_bar, 1, edit_menu, "Edit");  // Edit menu
winmenu_add_submenu(global.my_menu_bar, 2, options_menu, "Options");  // Options menu

// Exit menu item
winmenu_add(global.my_menu_bar, 9, "Close Editor");
winmenu_add(global.my_menu_bar, 10, "Exit");

// Set the menu bar to the game window
winmenu_bar_set(global.my_menu_bar);

// Set up menu handler
winmenu_bar_handler = winmenu_process;

</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="2" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
