            }   
        }
        
        else if (keyboard_check_released(ord('Z')))
        {
            scr_BuruwasuMapEditorAxisZUpMove(target3);   
        }
        
        else if (keyboard_check_released(ord('X')))
        {
            scr_BuruwasuMapEditorAxisZDownMove(target3);   
        }

        //destroy instance
        else if (keyboard_check_released(ord('P')))
        {
