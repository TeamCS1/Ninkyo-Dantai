        <arguments>
          <argument>
            <kind>1</kind>
            <string>//Allows to move
if canNowMoveObject == true
{
    if stringEntered == "target1"
    {
        //Update GUI to show controls
        transformationGUI = true;
        startGUI = false;
        
        if (keyboard_check_released(vk_up))
        {
            with target1
            {
                x += global.pixelSpacing
                show_debug_message("Moved Target 1 Forward by 64px!")
            }   
        }
        
        else if (keyboard_check_released(vk_down))
        {
            with target1
            {
                x -= global.pixelSpacing
                show_debug_message("Moved Target 1 Backwards by 64px!")
            }   
        }
        
        else if (keyboard_check_released(vk_left))
        {
            with target1
            {
                y -= global.pixelSpacing
                show_debug_message("Moved Target 1 Left by 64px!")
            }   
        }
        
        else if (keyboard_check_released(vk_right))
        {
            with target1
            {
                y += global.pixelSpacing
                show_debug_message("Moved Target 1 Right by 64px!")
            }   
        }
        
        else if (keyboard_check_released(ord('Z')))
        {
            scr_BuruwasuMapEditorAxisZUpMove(target1);   
        }
        
        else if (keyboard_check_released(ord('X')))
        {
            scr_BuruwasuMapEditorAxisZDownMove(target1);   
        }
        
        //destroy instance
        else if (keyboard_check_released(ord('P')))
        {
            scr_BuruwasuMapEditorObjectDestroy(target1);   
        }
    }

    if stringEntered == "target2"
    {
        //Update GUI to show controls
        transformationGUI = true;
        startGUI = false;
        
        if (keyboard_check_released(vk_up))
        {
            with target2
            {
                x += global.pixelSpacing
                show_debug_message("Moved Target 2 Forward by 64px!")
            }   
        }
        
        else if (keyboard_check_released(vk_down))
        {
            with target2
            {
                x -= global.pixelSpacing
                show_debug_message("Moved Target 2 Backwards by 64px!")
            }   
        }
        
        else if (keyboard_check_released(vk_left))
        {
            with target2
            {
                y -= global.pixelSpacing
                show_debug_message("Moved Target 2 Left by 64px!")
            }   
        }
        
        else if (keyboard_check_released(vk_right))
        {
            with target2
            {
                y += global.pixelSpacing
                show_debug_message("Moved Target 2 Right by 64px!")
            }   
        }
        
        else if (keyboard_check_released(ord('Z')))
        {
            scr_BuruwasuMapEditorAxisZUpMove(target2);   
        }
        
        else if (keyboard_check_released(ord('X')))
        {
            scr_BuruwasuMapEditorAxisZDownMove(target2);   
        }
        
        //destroy instance
        else if (keyboard_check_released(ord('P')))
        {
            scr_BuruwasuMapEditorObjectDestroy(target2);   
        }
    } 
    
    if stringEntered == "target3"
    {
        //Update GUI to show controls
        transformationGUI = true;
        startGUI = false;
        
        if (keyboard_check_released(vk_up))
        {
            with target3
            {
                x += global.pixelSpacing
                show_debug_message("Moved Target 3 Forward by 64px!")
            }   
        }
        
        else if (keyboard_check_released(vk_down))
        {
            with target3
            {
                x -= global.pixelSpacing
                show_debug_message("Moved Target 3 Backwards by 64px!")
            }   
        }
        
        else if (keyboard_check_released(vk_left))
        {
            with target3
            {
