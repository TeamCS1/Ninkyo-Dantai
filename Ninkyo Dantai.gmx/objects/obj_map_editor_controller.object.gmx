      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>//draw the map editor inspector
draw_set_color(c_black);
draw_set_halign(fa_left);
draw_set_valign(fa_top);
draw_sprite(spr_map_editor_inspector,0,1500,400);

draw_set_font(ft_map_editor_buruwasu);
draw_set_color(c_black)
draw_text(1640,820,string(global.pixelSpacing) + " Pixel(s)");

draw_text(1640,953,string(instance_number(all)) + " are active");

if startGUI == true
{
    draw_set_alpha(0.8);
    draw_rectangle_colour(5,100,500,190,c_black,c_black,c_black,c_black,false);
    draw_set_alpha(1.0);
    
    draw_set_color(c_white);
    draw_text(10,110,string("F2 - Re-scan Nearest Objects"))
    draw_text(10,130,string("F3 - Select Object From List"))
    draw_text(10,150,string("? - Create New Object"))
    
    draw_set_alpha(0.8)
    draw_rectangle_colour(10,830,200,1000,c_black,c_black,c_black,c_black,false)
    draw_set_alpha(1.0);
    draw_text(10,830,string("Objects Found List:"))
    draw_text(10,860,string(target1) + " target1")
    draw_text(10,890,string(target2) + " target2")
    draw_text(10,920,string(target3) + " target3")
    draw_text(10,950,string(target4) + " target4")
    
}

if transformationGUI == true
{
    draw_set_font(ft_map_editor_buruwasu);
    draw_set_color(c_white);
    
    draw_text(x,y + 20,"You have selected an Instance to modify.");
    draw_text(x,y + 100,"Move Shape - Arrows");
    draw_text(x,y + 120,"Z Up - Z");
    draw_text(x,y + 140,"Z Down - X");
    draw_text(x,y + 160,"Delete Selected Shape - P");
    draw_text(x,y + 200,"Back to Main Menu/Confirm Selection - F12");

    var t = noone;
    var tname = "";

    if stringEntered == "target1" { t = target1; tname = "target1"; }
    if stringEntered == "target2" { t = target2; tname = "target2"; }
    if stringEntered == "target3" { t = target3; tname = "target3"; }
    if stringEntered == "target4" { t = target4; tname = "target4"; }

    if instance_exists(t)
    {
        var tx = t.x;
        var ty = t.y;
        var tz;

        if t.zIsTwoPoints == true
            tz = t.z1;
        else
            tz = t.z;

        draw_set_color(c_green);
        draw_text(1500,795,
            "Object Coordinates: " + string(tx) + "," + string(ty) + "," + string(tz)
        );

        draw_set_color(c_green);
        draw_text(1500,765,
            "Selected Target: " + tname + " (" + string(t) + ")"
        );
    }
    else
    {
        draw_set_color(c_red);
        draw_text(1500,765,"Object Coordinates: [NO TARGET]");
        draw_text(1500,795,"Selected Target: " + tname + " [INVALID]");
    }
}
</string>
