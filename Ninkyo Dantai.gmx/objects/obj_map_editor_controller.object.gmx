        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Finds 4 nearest instances

//1
target1 = instance_nth_nearest(obj_player_buruwasu.x,obj_player_buruwasu.y,all,1);

with target1
{
    target1 = object_get_name(object_index);
    show_debug_message("1 " + target1)
}

//2
target2 = instance_nth_nearest(obj_player_buruwasu.x,obj_player_buruwasu.y,all,2);

with target2
{
    target2 = object_get_name(object_index);
    show_debug_message("2 " + target2)
}

//3
target3 = instance_nth_nearest(obj_player_buruwasu.x,obj_player_buruwasu.y,all,3);

with target3
{
    target3 = object_get_name(object_index);
    show_debug_message("3 " + target3)
}

//4
target4 = instance_nth_nearest(obj_player_buruwasu.x,obj_player_buruwasu.y,all,4);

with target4
{
    target4 = object_get_name(object_index);
    show_debug_message("4 " + target4)
}

//Found Items
show_debug_message("Found " + string(instance_count) + string(" Instances"))
show_debug_message("Showing nearest 4.")
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
