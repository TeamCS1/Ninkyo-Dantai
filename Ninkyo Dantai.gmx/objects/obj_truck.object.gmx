    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>///Car Controller
with obj_player_buruwasu
{
    sprite_index = spr_empty    //Hide the player
    x = obj_truck.x
    y = obj_truck.y
}

fakeSpeed = speed * 15;

var a = keyboard_check(vk_left);
var d = keyboard_check(vk_right);
var w = keyboard_check(vk_up);
var s = keyboard_check(vk_down);

if (w) 
{
    speed += acceleration;
}

if (d)
{
    direction -= speed * turnradius;
}


if (s) 
{
    speed -= brake;
}

if (a)
{
    direction += speed * turnradius;
}

//braking
if !w and !s
{
    if friction &lt; 1 
    {  
        friction += 0.001 / brakeStrength;
    }
}
else friction = 0;

//set max speed forward and reverse
if speed &gt; forwardspd 
{
    speed = forwardspd
}

if speed &lt; reversespd 
{
    speed = reversespd
}

//limits the turning the faster you go

if speed &gt; 3
{
    turnradius = 0.3;
    //lower number low radius
}

if speed &lt; 3
{
    turnradius = 0.5;
    //lower number low radius
}

//gear numbers
if fakeSpeed &lt;= 0
{
    gearNumber = "R"
}

if fakeSpeed &gt; 0 &amp;&amp; fakeSpeed &lt; 5
{
    gearNumber = "1"
}

if fakeSpeed &gt; 6 &amp;&amp; fakeSpeed &lt; 23
{
    gearNumber = "2"
}

if fakeSpeed &gt; 24 &amp;&amp; fakeSpeed &lt; 30
{
    gearNumber = "3"
}

if fakeSpeed &gt; 31 &amp;&amp; fakeSpeed &lt; 40
{
    gearNumber = "4"
}

if fakeSpeed &gt; 41 &amp;&amp; fakeSpeed &lt; 53
{
    gearNumber = "5"
}

if fakeSpeed &gt; 54 
{
    gearNumber = "6"
}
</string>
          </argument>
        </arguments>
      </action>
    </event>
