frontGrip = 0.11;              // front lets go first - understeers, pushes wide
rearGrip = 0.15;               // rear stays planted, so it resists rotating
corneringStiffness = 0.04;     // lazy, soft response
steerLock = 32;
steerLockTop = 5;              // barely any lock at speed - must slow right down
steerSpeed = 0.8;              // slow, heavy wheel
steerReturn = 1.4;
yawInertia = 260;              // a rig does not change direction in a hurry
yawDamp = 0.985;
lateralDamp = 0.975;
weightTransfer = 0.32;         // lots of mass moving around
handbrakeGrip = 0.35;          // hard to break loose deliberately
drag = 0.997;                  // carries momentum
brakePower = 0.09;             // worst brakes of the fleet
axleFront = 30;                // long wheelbase
axleRear = 30;
</string>
          </argument>
