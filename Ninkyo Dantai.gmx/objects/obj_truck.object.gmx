lateralDamp = 0.93;
weightTransfer = 0.32;         // lots of mass moving around
handbrakeGrip = 0.35;          // hard to break loose deliberately
drag = 0.997;                  // carries momentum
brakePower = 0.09;             // worst brakes of the fleet
axleFront = 1.5;               // long wheelbase
axleRear = 1.5;
</string>
