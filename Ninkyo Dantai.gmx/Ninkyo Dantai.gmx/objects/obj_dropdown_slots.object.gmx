        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// PRESSED EVENT LISTENER
var mouseX = window_mouse_get_x();
var mouseY = window_mouse_get_y();

if (position_meeting(mouseX, mouseY, id))
{
    image_index = 1;

    if (mouse_check_button_released(mb_left) &amp;&amp; targetObject != noone)
    {
        //spawn a new piece of furniture next to the player, tagged with
        //its own stable id so save/load can tell it apart from any other
        //instance of the same type
        var _newInst = instance_create(obj_player_buruwasu.x, obj_player_buruwasu.y, targetObject);
        _newInst.furnitureId = global.nextFurnitureId;
        global.nextFurnitureId += 1;

        //close the dropdown after adding
        obj_dropdown_slots.x = -5000;
        obj_dropdown_home_customisation.dropdown_visible = false;
    }
}
else
{
    image_index = 0;
}
</string>
          </argument>
        </arguments>
      </action>
