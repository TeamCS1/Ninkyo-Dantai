            <string>zIsTwoPoints = false; //used for map editor
z = 0;
zDirection = 0;
light = 1;
lamp = scr_load_model(working_directory + "Assets\Buruwasu\mdl_lamp_post.d3d");
//setup collisions
image_xscale = 1.0;
image_yscale = 1.0;

lampLight = instance_create(x,y,obj_light_source);
lampLight.light_z = 64;
lampLight.light_col = c_white;
lampLight.light_range = 150;


</string>
