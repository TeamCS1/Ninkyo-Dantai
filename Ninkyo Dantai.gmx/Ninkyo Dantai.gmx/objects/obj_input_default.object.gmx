  <solid>0</solid>
  <visible>-1</visible>
  <depth>-100</depth>
  <persistent>0</persistent>
  <parentName>&lt;undefined&gt;</parentName>
  <maskName>&lt;undefined&gt;</maskName>
  <events>
    <event eventtype="0" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>c_input = global.npcCount; 
c_input = string(global.npcCount);

c_cursor = '_' //Change for the symbol you want. That 3 lines handle the cursor.
flash = 0 //boolean
alarm[0] = 20;

linked_object = noone //The object we will send an input.
max_string = 0 //Max length of string, will be set by the script: scr_call_input(...)
keyboard_string = string(global.npcCount);
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="2" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>//A simple alarm loop to make the cursor flash.
flash = !flash

if flash
{
    c_cursor = ' '
}
else
{
    c_cursor = '_'
}
alarm[0] = 20

</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>if keyboard_check_pressed(vk_escape) //To interrupt the input.
{
    io_clear()
    obj_city_population_input.openPopup = false;
    instance_destroy()
}

if string_length(keyboard_string) &gt; max_string
{
    keyboard_string = string_copy(keyboard_string, 1, max_string); //That prevents the string from being too long.
}

if keyboard_check_pressed(vk_enter) //When enter is pressed, the string is copied to global.current_input and then we activate our linked_object to receive information.
{
    linked_object.receive_input = true;
    obj_buruwasu_debug_console.openPopup = false;
    //information is passed. Destroy obj_input.
    //io_clear()
    //instance_destroy();

    var inputs;
    inputs = string_digits(c_input);
    global.npcCount = real(c_input);  
    io_clear()
    obj_city_population_input.openPopup = false;
    instance_destroy()
} 

c_input = string_replace_all(keyboard_string, "#", "\#"); //To prevent the string to add # to break the line.  
</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="75">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>draw_set_valign(fa_top);
draw_set_halign(fa_left);
draw_set_font(ft_map_editor_buruwasu);

draw_set_colour(c_gray);    
draw_text(x - 215,y - 20,string("Helper Text: Enter a integer that is over 100, default: 200"));
draw_set_colour(c_white);
draw_text(x,y + 10,string(c_input) + c_cursor); //This is what is typed.



</string>
          </argument>
        </arguments>
      </action>
    </event>
  </events>
  <PhysicsObject>0</PhysicsObject>
  <PhysicsObjectSensor>0</PhysicsObjectSensor>
