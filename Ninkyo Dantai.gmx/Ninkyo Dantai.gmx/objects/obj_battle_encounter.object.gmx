{
    if distance_to_object(obj_player_buruwasu) &lt;= 16
    {
        draw_set_font(ft_buruwasu_gui);
        draw_set_halign(fa_left);
        draw_text_shadow_tooltips(string("I - Start Battle"),ft_buruwasu_gui,3,c_black,c_blue,c_white,1.0,1.0);
    }
}

