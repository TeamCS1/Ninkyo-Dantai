    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>currentRAMUsage = ram_application()/1024/1024;

if currentRAMUsage &lt; 4000 &amp;&amp; currentRAMUsage &gt; 3001
{
    helperText = "Ram Usage is too high, reduce settings!";
    colourChoice = c_red;
}

else if currentRAMUsage &lt; 3000 &amp;&amp; currentRAMUsage &gt; 2001
{
    helperText = "Ram Usage is high, consider changing settings.";
    colourChoice = c_red;
}

else if currentRAMUsage &lt; 2000 &amp;&amp; currentRAMUsage &gt; 1001
{
    helperText = "Ram Usage is at normal operation.";
    colourChoice = c_orange;
}

else if currentRAMUsage &lt; 1000 &amp;&amp; currentRAMUsage &gt; 0
{
    helperText = "";
    colourChoice = c_green;
}

</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="75">
