        <arguments>
          <argument>
            <kind>1</kind>
            <string>draw_set_font(ft_options);
draw_set_color(c_white);
//draw_text(x,y,string(ram_application()/1024/1024)+" MB / " + "4096 MB"); Old Method

draw_set_color(string(colourChoice));
draw_text(x,y,string(currentRAMUsage)+" MB / " + "4096 MB");

draw_set_color(c_white);
draw_text(x,y -30,string(helperText));
</string>
          </argument>
        </arguments>
      </action>
