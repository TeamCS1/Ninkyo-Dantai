          <argument>
            <kind>1</kind>
            <string>x = 1400;
y = 250;

drop_x = 0;
drop_y = 0;
drop_created = false;
cleanup_ready = false;

owner = noone;
fight_finished = false;

enemyHealthMax = 100;
enemyCurrentHealth = 100;

</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="3" enumb="0">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>/// STEP EVENT

// 1. Detect enemy death
if enemyCurrentHealth &lt;= 0
{
    fight_finished = true;
}

// 2. SPAWN MONEY DROP (ONLY ONCE)
if fight_finished &amp;&amp; !drop_created
{
    // Get drop position
    if instance_exists(encounter_id)
    {
        drop_x = encounter_id.x;
        drop_y = encounter_id.y;
    }
    else
    {
        // fallback
        drop_x = x;
        drop_y = y;
    }

    instance_create(drop_x, drop_y, obj_drop_bag_of_money);

    drop_created = true;

    // Tell next step to clean up
    cleanup_ready = true;

    exit; // STOP this step so nothing gets destroyed wrong
}

// 3. CLEANUP — ONLY RUNS ONE STEP AFTER DROP IS CREATED
if cleanup_ready
{
    // Destroy encounter members
    if instance_exists(encounter_id)
    {
        with (encounter_id)
        {
            if instance_exists(topID) instance_destroy(topID);
            if instance_exists(bottomID) instance_destroy(bottomID);
            instance_destroy(); // destroy encounter
        }
    }

    instance_destroy(); // destroy HUD
}

</string>
          </argument>
        </arguments>
      </action>
    </event>
    <event eventtype="8" enumb="64">
      <action>
        <libid>1</libid>
        <id>603</id>
        <kind>7</kind>
        <userelative>0</userelative>
        <isquestion>0</isquestion>
        <useapplyto>-1</useapplyto>
        <exetype>2</exetype>
        <functionname></functionname>
        <codestring></codestring>
        <whoName>self</whoName>
        <relative>0</relative>
        <isnot>0</isnot>
        <arguments>
          <argument>
            <kind>1</kind>
            <string>//draw the hud first
draw_sprite(spr_battle_enemy_hud,0,1400,250);

draw_text_shadow(x+120,y,string("Street Delinquent"),ft_battle_interface,3,c_black,c_white,c_white,1.0,1.0);
draw_text_shadow(x+120,y +30,string(global.enemyFirstName),ft_battle_interface,3,c_black,c_white,c_white,1.0,1.0);
draw_text_shadow(x+250,y +30,string("Lv. 1"),ft_battle_interface,3,c_black,c_white,c_white,1.0,1.0);

var pc;
    pc = (enemyCurrentHealth / enemyHealthMax) * 100;
    draw_healthbar(x+120, y+64, x+415, y+67, pc, c_black, c_red, c_red, 0, true, true);
    
    if mouse_check_button_released(mb_left)
    {
        enemyCurrentHealth -= irandom_range(5,17);    
        
    }
    
    if enemyCurrentHealth &lt; 90
    {
        draw_set_font(ft_buruwasu_gui);
        draw_set_halign(fa_left);
        draw_set_colour(c_aqua);
        draw_text(150,150,"Damage Dealt!");
    }
    
    if enemyCurrentHealth &lt;= 0
    {
        draw_set_font(ft_buruwasu_gui);
        draw_set_halign(fa_left);
        // mark fight as finished, but DO NOT destroy HUD here
        fight_finished = true;
    }
  

</string>
          </argument>
        </arguments>
      </action>
